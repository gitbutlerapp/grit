{
  "$id": "https://grit-scm.com/schemas/tag/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "TagAnnotationEntry": {
      "description": "Annotated tag metadata in list JSON.",
      "properties": {
        "date": {
          "description": "Tagger Unix timestamp.",
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "tagger": {
          "$ref": "#/definitions/TagIdentEntry"
        }
      },
      "required": [
        "date",
        "message",
        "subject",
        "tagger"
      ],
      "type": "object"
    },
    "TagEntry": {
      "description": "One tag in a `list` outcome.",
      "properties": {
        "annotation": {
          "anyOf": [
            {
              "$ref": "#/definitions/TagAnnotationEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/definitions/TagRefKind"
        },
        "name": {
          "type": "string"
        },
        "oid": {
          "description": "Hex object id the tag ref points at.",
          "type": "string"
        },
        "peeled": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_kind": {
          "description": "Object kind the tag points at (`commit`, `tag`, `tree`, `blob`).",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "oid",
        "target_kind"
      ],
      "type": "object"
    },
    "TagIdentEntry": {
      "properties": {
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "name"
      ],
      "type": "object"
    },
    "TagRefKind": {
      "description": "Tag ref kind in JSON (`lightweight` or `annotated`).",
      "enum": [
        "lightweight",
        "annotated"
      ],
      "type": "string"
    }
  },
  "description": "Result of `grit tag`, tagged by `action` (`list` / `create` / `delete`).",
  "oneOf": [
    {
      "description": "Tags matching the list query (default sort: version).",
      "properties": {
        "action": {
          "enum": [
            "list"
          ],
          "type": "string"
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "tags"
      ],
      "type": "object"
    },
    {
      "description": "A new tag was created.",
      "properties": {
        "action": {
          "enum": [
            "create"
          ],
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TagRefKind"
        },
        "name": {
          "type": "string"
        },
        "oid": {
          "description": "Hex object id the tag ref points at.",
          "type": "string"
        },
        "peeled": {
          "type": [
            "string",
            "null"
          ]
        },
        "signed": {
          "description": "Whether the tag object carries a cryptographic signature.",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "kind",
        "name",
        "oid",
        "signed"
      ],
      "type": "object"
    },
    {
      "description": "A tag was deleted.",
      "properties": {
        "action": {
          "enum": [
            "delete"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "name"
      ],
      "type": "object"
    }
  ],
  "title": "TagOutcome"
}
