{
  "$id": "https://grit-scm.com/schemas/notes/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "NoteEntry": {
      "description": "One note in a `list` outcome.",
      "properties": {
        "blob": {
          "description": "Note blob object id (full hex).",
          "type": "string"
        },
        "body": {
          "description": "Note text (UTF-8 lossy when not valid UTF-8).",
          "type": "string"
        },
        "object": {
          "description": "Annotated object id (full hex).",
          "type": "string"
        }
      },
      "required": [
        "blob",
        "body",
        "object"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit notes`, tagged by `action`.",
  "oneOf": [
    {
      "description": "All notes under the selected ref.",
      "properties": {
        "action": {
          "enum": [
            "list"
          ],
          "type": "string"
        },
        "notes": {
          "items": {
            "$ref": "#/definitions/NoteEntry"
          },
          "type": "array"
        },
        "notes_ref": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "notes",
        "notes_ref"
      ],
      "type": "object"
    },
    {
      "description": "Note bytes for one object.",
      "properties": {
        "action": {
          "enum": [
            "show"
          ],
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "notes_ref": {
          "type": "string"
        },
        "object": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "body",
        "notes_ref",
        "object"
      ],
      "type": "object"
    },
    {
      "description": "A note was written.",
      "properties": {
        "action": {
          "enum": [
            "add"
          ],
          "type": "string"
        },
        "notes_ref": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "replaced": {
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "notes_ref",
        "object",
        "replaced"
      ],
      "type": "object"
    },
    {
      "description": "Notes were removed from one or more objects.",
      "properties": {
        "action": {
          "enum": [
            "remove"
          ],
          "type": "string"
        },
        "notes_ref": {
          "type": "string"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "notes_ref",
        "objects"
      ],
      "type": "object"
    }
  ],
  "title": "NotesOutcome"
}
