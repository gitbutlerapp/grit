{
  "$id": "https://grit-scm.com/schemas/init/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit init`.",
  "properties": {
    "bare": {
      "type": "boolean"
    },
    "branch": {
      "type": "string"
    },
    "git_dir": {
      "description": "Separate git directory when `--separate-git-dir` was used.",
      "type": "string"
    },
    "object_format": {
      "description": "Object hash algorithm (`sha1` or `sha256`).",
      "type": "string"
    },
    "initialized": {
      "description": "`true` when a new repository was created.",
      "type": "boolean"
    },
    "path": {
      "description": "The created `.git` directory.",
      "type": "string"
    },
    "ref_format": {
      "description": "Ref storage backend (`files` or `reftable`).",
      "type": "string"
    },
    "reinitialized": {
      "description": "`true` when an existing repository was reinitialized in place.",
      "type": "boolean"
    }
  },
  "required": [
    "bare",
    "branch",
    "initialized",
    "object_format",
    "path",
    "ref_format"
  ],
  "title": "InitOutcome",
  "type": "object"
}
