{
  "$id": "https://grit-scm.com/schemas/bundle.unbundle/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "BundleRefJson": {
      "properties": {
        "name": {
          "type": "string"
        },
        "oid": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "oid"
      ],
      "type": "object"
    },
    "BundleRefUpdateJson": {
      "description": "One ref update that would be applied when unbundling with ref writes enabled.",
      "properties": {
        "name": {
          "type": "string"
        },
        "new_oid": {
          "type": "string"
        },
        "old_oid": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "new_oid"
      ],
      "type": "object"
    }
  },
  "description": "Outcome of `grit bundle unbundle`.",
  "properties": {
    "bytes": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "missing_prerequisites": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "object_count": {
      "format": "uint32",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "objects": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "path": {
      "type": "string"
    },
    "ref_updates": {
      "items": {
        "$ref": "#/definitions/BundleRefUpdateJson"
      },
      "type": "array"
    },
    "references": {
      "items": {
        "$ref": "#/definitions/BundleRefJson"
      },
      "type": "array"
    }
  },
  "required": [
    "path",
    "references"
  ],
  "title": "BundleUnbundleOutcome",
  "type": "object"
}
