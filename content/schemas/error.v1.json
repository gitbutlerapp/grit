{
  "$id": "https://grit-scm.com/schemas/error/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "description": "Usual command failure (`{\"error\":\"…\"}` only).",
      "properties": {
        "error": {
          "description": "Same text a human sees after `error:` on stderr.",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    {
      "allOf": [
        {
          "$ref": "#/definitions/StructuredJsonError"
        }
      ],
      "description": "Typed failure (conflicts, …)."
    }
  ],
  "definitions": {
    "ErrorKind": {
      "description": "Machine-readable failure category in structured JSON errors (`kind` field).",
      "oneOf": [
        {
          "description": "Merge, pick, rebase, or similar would introduce conflicts.",
          "enum": [
            "conflict"
          ],
          "type": "string"
        },
        {
          "description": "Object ingestion detected an SHA-1 chosen-prefix collision (sha1dc).",
          "enum": [
            "hash_collision"
          ],
          "type": "string"
        },
        {
          "description": "Checkout or switch would overwrite local or untracked files.",
          "enum": [
            "would_overwrite"
          ],
          "type": "string"
        },
        {
          "description": "Refused because a merge, rebase, pick or revert is paused (finish or abort it first).",
          "enum": [
            "operation_in_progress"
          ],
          "type": "string"
        },
        {
          "description": "Invalid `--author`, `--grep`, pickaxe, or similar filter pattern.",
          "enum": [
            "invalid_pattern"
          ],
          "type": "string"
        },
        {
          "description": "Invalid command arguments for a specific subcommand (exit code 2).",
          "enum": [
            "usage"
          ],
          "type": "string"
        },
        {
          "description": "Incompatible flag combination (often with `--json` / `--markdown`).",
          "enum": [
            "incompatible_flags"
          ],
          "type": "string"
        },
        {
          "description": "Another process holds the index lock; refs, reflog and index are unchanged, so retrying is safe.",
          "enum": [
            "index_locked"
          ],
          "type": "string"
        },
        {
          "description": "Branch already exists on create.",
          "enum": [
            "branch_already_exists"
          ],
          "type": "string"
        },
        {
          "description": "Named branch does not exist.",
          "enum": [
            "branch_not_found"
          ],
          "type": "string"
        },
        {
          "description": "Branch name failed validation.",
          "enum": [
            "branch_invalid_name"
          ],
          "type": "string"
        },
        {
          "description": "Delete refused: branch is not fully merged.",
          "enum": [
            "branch_not_fully_merged"
          ],
          "type": "string"
        },
        {
          "description": "Branch is checked out in this or another worktree.",
          "enum": [
            "branch_checked_out"
          ],
          "type": "string"
        },
        {
          "description": "Repository has no commits yet.",
          "enum": [
            "branch_no_commits"
          ],
          "type": "string"
        },
        {
          "description": "`--start` / tracking start point could not be resolved.",
          "enum": [
            "branch_invalid_start_point"
          ],
          "type": "string"
        },
        {
          "description": "Upstream is not a tracking branch.",
          "enum": [
            "branch_upstream_not_tracking"
          ],
          "type": "string"
        },
        {
          "description": "Branch has no upstream configured.",
          "enum": [
            "branch_no_upstream"
          ],
          "type": "string"
        },
        {
          "description": "Other branch operation failure.",
          "enum": [
            "branch_error"
          ],
          "type": "string"
        },
        {
          "description": "A hook exited non-zero (`hook.name`, `hook.status`, `hook.stdout`, `hook.stderr`).",
          "enum": [
            "hook_failed"
          ],
          "type": "string"
        },
        {
          "description": "A branch, tag, commit id or revision expression names nothing.",
          "enum": [
            "revision_not_found"
          ],
          "type": "string"
        },
        {
          "description": "Clone, fetch, pull, push, or `remote refs` could not reach or read the remote (exit 128).",
          "enum": [
            "remote_unreadable"
          ],
          "type": "string"
        },
        {
          "description": "Push has no remote: none was named and no `origin` is configured.",
          "enum": [
            "no_remote"
          ],
          "type": "string"
        },
        {
          "description": "A named remote is not configured.",
          "enum": [
            "remote_not_found"
          ],
          "type": "string"
        },
        {
          "description": "A configured remote has no URL.",
          "enum": [
            "remote_no_url"
          ],
          "type": "string"
        },
        {
          "description": "The server wants credentials and none were available.",
          "enum": [
            "auth_required"
          ],
          "type": "string"
        },
        {
          "description": "The server rejected the credentials that were sent.",
          "enum": [
            "auth_rejected"
          ],
          "type": "string"
        },
        {
          "description": "`merge --continue` found conflicts that are not resolved (or not staged) yet (`paths`).",
          "enum": [
            "unmerged_paths"
          ],
          "type": "string"
        },
        {
          "description": "Staged or unstaged changes block the operation (`paths`).",
          "enum": [
            "dirty_worktree"
          ],
          "type": "string"
        },
        {
          "description": "Worktree file I/O failed on a named path (`paths`, often one entry).",
          "enum": [
            "worktree_path_io"
          ],
          "type": "string"
        }
      ]
    },
    "HookFailureJson": {
      "description": "A hook that exited non-zero, when `kind == \"hook_failed\"`.",
      "properties": {
        "name": {
          "description": "Hook event name (`pre-commit`, `commit-msg`, …).",
          "type": "string"
        },
        "status": {
          "description": "The hook's exit code.",
          "format": "int32",
          "type": "integer"
        },
        "stderr": {
          "description": "What the hook wrote to stderr (lossy UTF-8).",
          "type": "string"
        },
        "stdout": {
          "description": "What the hook wrote to stdout (lossy UTF-8).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "stderr",
        "stdout"
      ],
      "type": "object"
    },
    "StructuredJsonError": {
      "description": "JSON object emitted on stdout for structured command failures.",
      "properties": {
        "commit": {
          "description": "Commit that could not be replayed cleanly, when `kind == \"conflict\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "conflicts": {
          "description": "Conflicting paths, when `kind == \"conflict\"`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "error": {
          "description": "Short, stable summary for scripts.",
          "type": "string"
        },
        "hint": {
          "description": "The next command to run, in prose (also printed as `hint:` on stderr).",
          "type": [
            "string",
            "null"
          ]
        },
        "hook": {
          "anyOf": [
            {
              "$ref": "#/definitions/HookFailureJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "The failing hook and what it wrote, when `kind == \"hook_failed\"`."
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/ErrorKind"
            }
          ],
          "description": "Machine-readable category (e.g. `conflict`)."
        },
        "oid": {
          "description": "Plain SHA-1 digest for colliding input, when `kind == \"hash_collision\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "description": "Repository-relative paths the failure is about, when `kind` is `unmerged_paths` or `dirty_worktree`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "would_overwrite": {
          "anyOf": [
            {
              "$ref": "#/definitions/WouldOverwriteJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "Overwrite details when `kind == \"would_overwrite\"`."
        }
      },
      "required": [
        "error",
        "kind"
      ],
      "type": "object"
    },
    "WouldOverwriteJson": {
      "description": "Paths that would be overwritten, when `kind == \"would_overwrite\"`.",
      "properties": {
        "paths": {
          "description": "Sorted, deduplicated repository-relative paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "`local_changes` or `untracked`.",
          "type": "string"
        }
      },
      "required": [
        "paths",
        "reason"
      ],
      "type": "object"
    }
  },
  "description": "Any `--json` failure object on stdout (schema contract only; see `error.v1.json`).",
  "title": "JsonErrorEnvelope"
}
