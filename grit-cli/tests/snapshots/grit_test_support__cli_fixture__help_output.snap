  "help status": "Show what's changed and where you are (this is the default)\n\nUsage: grit help status\n",
  "help switch": "Switch to another branch, remote branch, or detached commit\n\nUsage: grit help switch\n",
  "help sync": "Push and pull every active branch between this clone and your space on the server (GitButler Code)\n\nUsage: grit help sync\n",
  "help tag": "List tags, or create / delete one\n\nUsage: grit help tag\n",
  "help update": "Update grit to the latest release (re-runs the install script)\n\nUsage: grit help update\n",
  "help upload-pack": "Serve a fetch or clone over stdin/stdout (run by ssh and grit-http-server)\n\nUsage: grit help upload-pack\n",
  "help worktree": "List, add, or remove linked worktrees\n\nUsage: grit help worktree [COMMAND]\n\nCommands:\n  list    List registered worktrees (main first, then linked)\n  add     Create a linked worktree at `path`\n  remove  Remove a linked worktree\n  prune   Drop registrations for linked worktrees whose directories are gone\n  lock    Mark a linked worktree as locked (prevents accidental removal)\n  unlock  Clear the lock on a linked worktree\n  move    Move a linked worktree to a new directory\n  repair  Fix `.git` / `gitdir` links after a manual directory move\n  help    Print this message or the help of the given subcommand(s)\n",
  "help worktree add": "Create a linked worktree at `path`\n\nUsage: grit help worktree add\n",
  "help worktree help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help worktree help [COMMAND]\n\nCommands:\n  list    List registered worktrees (main first, then linked)\n  add     Create a linked worktree at `path`\n  remove  Remove a linked worktree\n  prune   Drop registrations for linked worktrees whose directories are gone\n  lock    Mark a linked worktree as locked (prevents accidental removal)\n  unlock  Clear the lock on a linked worktree\n  move    Move a linked worktree to a new directory\n  repair  Fix `.git` / `gitdir` links after a manual directory move\n  help    Print this message or the help of the given subcommand(s)\n",
  "help worktree help add": "Create a linked worktree at `path`\n\nUsage: grit help worktree help add\n",
  "help worktree help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help worktree help help\n",
