{
  "$id": "https://grit-scm.com/schemas/switch/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit switch`.",
  "properties": {
    "branch": {
      "type": "string"
    },
    "changed_paths": {
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "type": "boolean"
    },
    "detached": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    }
  },
  "required": [
    "branch",
    "created",
    "detached"
  ],
  "title": "SwitchOutcome",
  "type": "object"
}
