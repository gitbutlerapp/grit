{
  "$id": "https://grit-scm.com/schemas/tag/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "TagEntry": {
      "description": "One tag in a `list` outcome.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/TagRefKind"
        },
        "name": {
          "type": "string"
        },
        "oid": {
          "description": "Hex object id the tag ref points at.",
          "type": "string"
        },
        "peeled": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "oid"
      ],
      "type": "object"
    },
    "TagRefKind": {
      "description": "Tag ref kind in JSON (`lightweight` or `annotated`).",
      "enum": [
        "lightweight",
        "annotated"
      ],
      "type": "string"
    }
  },
  "description": "Result of `grit tag`, tagged by `action` (`list` / `create` / `delete`).",
  "oneOf": [
    {
      "description": "All tags in the repository, sorted by name.",
      "properties": {
        "action": {
          "enum": [
            "list"
          ],
          "type": "string"
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "tags"
      ],
      "type": "object"
    },
    {
      "description": "A new tag was created.",
      "properties": {
        "action": {
          "enum": [
            "create"
          ],
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TagRefKind"
        },
        "name": {
          "type": "string"
        },
        "oid": {
          "description": "Hex object id the tag ref points at.",
          "type": "string"
        },
        "peeled": {
          "type": [
            "string",
            "null"
          ]
        },
        "signed": {
          "description": "Whether the tag object carries a cryptographic signature.",
          "type": "boolean"
        },
        "tree_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree_sha256_excluded": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tree_sha256_files": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tree_sha256_hash_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tree_sha256_submodules": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "kind",
        "name",
        "oid",
        "signed"
      ],
      "type": "object"
    },
    {
      "description": "A tag was deleted.",
      "properties": {
        "action": {
          "enum": [
            "delete"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "name"
      ],
      "type": "object"
    }
  ],
  "title": "TagOutcome"
}
