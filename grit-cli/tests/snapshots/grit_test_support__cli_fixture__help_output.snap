  "help worktree help remove": "Remove a linked worktree\n\nUsage: grit help worktree help remove\n",
  "help worktree help repair": "Fix `.git` / `gitdir` links after a manual directory move\n\nUsage: grit help worktree help repair\n",
  "help worktree help unlock": "Clear the lock on a linked worktree\n\nUsage: grit help worktree help unlock\n",
  "help worktree list": "List registered worktrees (main first, then linked)\n\nUsage: grit help worktree list\n",
  "help worktree lock": "Mark a linked worktree as locked (prevents accidental removal)\n\nUsage: grit help worktree lock\n",
  "help worktree move": "Move a linked worktree to a new directory\n\nUsage: grit help worktree move\n",
  "help worktree prune": "Drop registrations for linked worktrees whose directories are gone\n\nUsage: grit help worktree prune\n",
  "help worktree remove": "Remove a linked worktree\n\nUsage: grit help worktree remove\n",
  "help worktree repair": "Fix `.git` / `gitdir` links after a manual directory move\n\nUsage: grit help worktree repair\n",
  "help worktree unlock": "Clear the lock on a linked worktree\n\nUsage: grit help worktree unlock\n",
  "history": "Rewrite commits without a sequencer (plan, then apply refs atomically)\n\nUsage: grit history [OPTIONS] <COMMAND>\n\nCommands:\n  drop    Remove a commit and replay descendants onto its parent\n  move    Reorder a commit on the first-parent chain of `HEAD`\n  reword  Replace a commit message and replay descendants onto the new history\n  fixup   Apply staged changes onto a commit and replay descendants\n  absorb  Assign staged hunks into recent commits and replay descendants once\n  rebase  Replay local commits onto a new base (same as top-level `grit rebase`)\n  split   Peel path-limited changes out of a commit into a new parent and replay descendants\n  undo    Undo the last applied history rewrite using the recorded ref plan\n  squash  Fold a revision range into the oldest commit and replay descendants\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history absorb": "Assign staged hunks into recent commits and replay descendants once\n\nUsage: grit history absorb [OPTIONS]\n\nOptions:\n      --base <BASE>\n          Oldest commit boundary (exclusive) for candidate commits\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history drop": "Remove a commit and replay descendants onto its parent\n\nUsage: grit history drop [OPTIONS] <COMMIT>\n\nArguments:\n  <COMMIT>\n          Commit to remove (revision spec)\n\nOptions:\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history fixup": "Apply staged changes onto a commit and replay descendants\n\nUsage: grit history fixup [OPTIONS] <COMMIT> [-- <PATH>...]\n\nArguments:\n  <COMMIT>\n          Commit to fix up (revision spec)\n\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --hunks <ID,...>\n          Unstaged hunk ids to fold (`grit diff --unstaged --json`, comma-separated or repeated)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Unstaged new-side line ranges to fold (`path:start-end` or `path:line`, comma-separated or repeated)\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit history help [COMMAND]\n\nCommands:\n  drop    Remove a commit and replay descendants onto its parent\n  move    Reorder a commit on the first-parent chain of `HEAD`\n  reword  Replace a commit message and replay descendants onto the new history\n  fixup   Apply staged changes onto a commit and replay descendants\n  absorb  Assign staged hunks into recent commits and replay descendants once\n  rebase  Replay local commits onto a new base (same as top-level `grit rebase`)\n  split   Peel path-limited changes out of a commit into a new parent and replay descendants\n  undo    Undo the last applied history rewrite using the recorded ref plan\n  squash  Fold a revision range into the oldest commit and replay descendants\n  help    Print this message or the help of the given subcommand(s)\n",
  "history help absorb": "Assign staged hunks into recent commits and replay descendants once\n\nUsage: grit history help absorb\n",
  "history help drop": "Remove a commit and replay descendants onto its parent\n\nUsage: grit history help drop\n",
  "history help fixup": "Apply staged changes onto a commit and replay descendants\n\nUsage: grit history help fixup\n",
  "history help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit history help help\n",
  "history help move": "Reorder a commit on the first-parent chain of `HEAD`\n\nUsage: grit history help move\n",
  "history help rebase": "Replay local commits onto a new base (same as top-level `grit rebase`)\n\nUsage: grit history help rebase\n",
  "history help reword": "Replace a commit message and replay descendants onto the new history\n\nUsage: grit history help reword\n",
  "history help split": "Peel path-limited changes out of a commit into a new parent and replay descendants\n\nUsage: grit history help split\n",
  "history help squash": "Fold a revision range into the oldest commit and replay descendants\n\nUsage: grit history help squash\n",
  "history help undo": "Undo the last applied history rewrite using the recorded ref plan\n\nUsage: grit history help undo\n",
  "history move": "Reorder a commit on the first-parent chain of `HEAD`\n\nUsage: grit history move [OPTIONS] <COMMIT>\n\nArguments:\n  <COMMIT>\n          Commit to move (revision spec)\n\nOptions:\n      --before <BEFORE>\n          Place the commit immediately before this revision\n\n      --after <AFTER>\n          Place the commit immediately after this revision\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history rebase": "Replay local commits onto a new base (same as top-level `grit rebase`)\n\nUsage: grit history rebase [OPTIONS] [UPSTREAM]\n\nArguments:\n  [UPSTREAM]\n          Commits to replay are those reachable from `HEAD` but not from this revision (defaults to `@{upstream}`)\n\nOptions:\n      --onto <REV>\n          Replay onto this commit instead of `UPSTREAM`\n\n      --continue\n          Finish a rebase stopped on conflicts after resolving and staging paths\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --abort\n          Cancel an in-progress rebase and restore the branch to its pre-rebase tip\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --skip\n          Skip the current commit and replay the rest\n\n      --check\n          Predict whether the rebase would succeed without changing refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -X <OURS|THEIRS>\n          Auto-resolve replay conflicts: `ours` keeps the onto side, `theirs` keeps replayed commits\n\n          Possible values:\n          - ours:   Favor the upstream / onto side during rebase replay (matches `git rebase -X ours`)\n          - theirs: Favor the commit being replayed (matches `git rebase -X theirs`)\n\n      --exec <CMD>\n          Run a shell command after each replayed commit is checked out (repeatable; incompatible with `--dry-run` and `--check`)\n\n      --no-verify\n          Skip the `pre-rebase` hook\n\n      --fork-point\n          Use the upstream reflog to find where the branch forked (implicit upstream only unless set)\n\n      --no-fork-point\n          Do not use the upstream reflog fork point (merge base only)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history reword": "Replace a commit message and replay descendants onto the new history\n\nUsage: grit history reword [OPTIONS] <COMMIT>\n\nArguments:\n  <COMMIT>\n          Commit to reword (revision spec)\n\nOptions:\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --author <AUTHOR>\n          Author ident (`Name <email>` or bare email)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history split": "Peel path-limited changes out of a commit into a new parent and replay descendants\n\nUsage: grit history split [OPTIONS] <COMMIT> [-- <PATH>...]\n\nArguments:\n  <COMMIT>\n          Commit to split (revision spec)\n\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --rest-message <REST_MESSAGE>\n          Replace the remaining commit's message after the split\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history squash": "Fold a revision range into the oldest commit and replay descendants\n\nUsage: grit history squash [OPTIONS] <RANGE>...\n\nArguments:\n  <RANGE>...\n          Revision range (same syntax as `git rev-list`, for example `base..tip`)\n\nOptions:\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --combine\n          Build a combined autosquash-style message from every commit in the range\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "history undo": "Undo the last applied history rewrite using the recorded ref plan\n\nUsage: grit history undo [OPTIONS]\n\nOptions:\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "hooks": "List hook scripts or run one by name\n\nUsage: grit hooks [OPTIONS] [COMMAND]\n\nCommands:\n  list  List hook scripts in the resolved hooks directory\n  run   Run a hook by name (passes `--` arguments through to the script)\n  help  Print this message or the help of the given subcommand(s)\n\nOptions:\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "hooks help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit hooks help [COMMAND]\n\nCommands:\n  list  List hook scripts in the resolved hooks directory\n  run   Run a hook by name (passes `--` arguments through to the script)\n  help  Print this message or the help of the given subcommand(s)\n",
  "hooks help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit hooks help help\n",
  "hooks help list": "List hook scripts in the resolved hooks directory\n\nUsage: grit hooks help list\n",
  "hooks help run": "Run a hook by name (passes `--` arguments through to the script)\n\nUsage: grit hooks help run\n",
  "hooks list": "List hook scripts in the resolved hooks directory\n\nUsage: grit hooks list [OPTIONS]\n\nOptions:\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "hooks run": "Run a hook by name (passes `--` arguments through to the script)\n\nUsage: grit hooks run [OPTIONS] <NAME> [HOOK_ARGS]...\n\nArguments:\n  <NAME>\n          Hook basename (e.g. `pre-commit`)\n\n  [HOOK_ARGS]...\n          Arguments forwarded to the hook after `--`\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "ignore": "Query exclude (gitignore) rules\n\nUsage: grit ignore [OPTIONS] <COMMAND>\n\nCommands:\n  check  Print whether paths match exclude rules\n  help   Print this message or the help of the given subcommand(s)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "ignore check": "Print whether paths match exclude rules\n\nUsage: grit ignore check [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Paths to query (repository-relative or from the current directory)\n\nOptions:\n      --all\n          Also list paths that are not ignored\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "ignore help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit ignore help [COMMAND]\n\nCommands:\n  check  Print whether paths match exclude rules\n  help   Print this message or the help of the given subcommand(s)\n",
  "ignore help check": "Print whether paths match exclude rules\n\nUsage: grit ignore help check\n",
  "ignore help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit ignore help help\n",
  "init": "Create a new, empty repository\n\nUsage: grit init [OPTIONS] [PATH]\n\nArguments:\n  [PATH]\n          Where to create the repository (defaults to the current directory)\n\nOptions:\n      --bare\n          Create a bare repository (no working tree)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --ref-format <FORMAT>\n          Ref storage backend for the new repository\n          \n          [default: files]\n\n  -b, --initial-branch <NAME>\n          Initial branch name (overrides `init.defaultBranch` from config)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --separate-git-dir <DIR>\n          Place the git directory here and link from the work tree via a gitfile\n\n      --object-format <ALGO>\n          Object hash algorithm for the new repository (default SHA-1; omitted on reinit preserves format)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "integrate": "Merge a branch into the server's target branch (checking it in first), then refresh this checkout\n\nUsage: grit integrate [OPTIONS] <BRANCH>\n\nArguments:\n  <BRANCH>\n          The branch to merge\n\nOptions:\n      --without <USER>\n          For a shared branch: integrate without waiting for this member's changes, which stay in their copy. Repeatable\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "log": "Show recent commits reachable from HEAD\n\nUsage: grit log [OPTIONS] [REV]... [-- <PATH>...]\n\nArguments:\n  [REV]...\n          Revision tips and ranges (`A..B`, `A...B`, `^tip`, plain tips)\n\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --skip <SKIP>\n          Skip this many commits after ordering\n          \n          [default: 0]\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --since <DATE>\n          Exclude commits older than this date (Git `--since`)\n\n      --after <DATE>\n          Alias for `--since`\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --until <DATE>\n          Exclude commits newer than this date (Git `--until`)\n\n      --before <DATE>\n          Alias for `--until` (date cutoff)\n\n      --first-parent\n          Follow only the first parent at merges\n\n      --follow\n          Follow a single file path across renames (Git `log --follow`)\n\n      --merges\n          Include only merge commits\n\n      --no-merges\n          Exclude merge commits\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --reverse\n          Reverse commit order (oldest first)\n\n      --all\n          Include every ref tip\n\n      --branches [<GLOB>]\n          Include branch tips, or those matching an optional glob\n\n      --tags [<GLOB>]\n          Include tag tips, or those matching an optional glob\n\n      --remotes [<GLOB>]\n          Include remote-tracking tips, or those matching an optional glob\n\n      --author <PAT>\n          Limit to commits whose author matches this pattern (repeatable; OR together)\n\n      --committer <PAT>\n          Limit to commits whose committer matches this pattern (repeatable; OR together)\n\n      --grep <PAT>\n          Limit to commits whose message matches this pattern (repeatable; OR unless `--all-match`)\n\n  -i, --regexp-ignore-case\n          Case-insensitive pattern matching for `--author`, `--committer`, and `--grep`\n\n      --all-match\n          Require every `--grep` pattern to match\n\n      --invert-grep\n          Invert `--grep` matching (commits that do not match the grep group)\n\n  -F, --fixed-strings\n          Treat `--author`, `--committer`, and `--grep` patterns as fixed strings\n\n      --no-mailmap\n          Do not apply `.mailmap` when matching `--author` or `--committer`\n\n  -S <STRING>\n          Keep commits where occurrence count of this string changed (`git log -S`)\n\n  -G <PAT>\n          Keep commits whose added/removed lines match this pattern (`git log -G`)\n\n      --pickaxe-regex\n          Treat `-S` as a BRE instead of a literal string (`--pickaxe-regex`)\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --cursor [<TOKEN>]\n          Continue a paged walk from the `TOKEN` a previous page printed (an empty value is ignored)\n\n  -p, --patch\n          Unified patch for each commit (`git log -p`)\n\n      --stat\n          Summary with change bars per file (like `git diff --stat`)\n\n      --numstat\n          Machine-readable `insertions<TAB>deletions<TAB>path` lines\n\n      --shortstat\n          Only the summary line (`N files changed, …`)\n\n      --name-only\n          Paths only, one per line\n\n      --name-status\n          Status letter and path(s) per line\n\n      --patch-text\n          Git-apply-compatible unified patch (`git diff --binary` shape); not combinable with `--json`\n\n  -U, --unified <N>\n          Lines of context around each change (Git `-U`)\n\n  -W, --function-context\n          Expand hunks to enclosing function boundaries (Git `-W` / `--function-context`)\n\n      --oneline\n          One line per commit: short oid and subject (refs when `--decorate`)\n\n      --decorate\n          Show branch and tag names that point at each commit\n\n      --group-by <FIELD>\n          Aggregate commits (`author` matches `git shortlog -sne` ordering)\n          \n          [possible values: author]\n\n      --count\n          With `--group-by`, omit per-commit lists in `--json` output\n\n      --graph\n          Draw a commit graph in human output (implies topological order; Unicode by default)\n\n      --no-pager\n          Write straight to the terminal instead of through the pager\n\n      --graph-ascii\n          Use ASCII `*|` lane characters in `--graph` output instead of Unicode box-drawing\n\n      --graph-unicode\n          Draw `--graph` with Unicode box-drawing (default when `--graph` is set)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "manager": "Git credential helper backed by the Windows Credential Manager.\n\nYou don't normally run this yourself — `grit auth` wires it into `credential.helper` on Windows. It speaks Git's credential protocol.\n\nUsage: grit manager [OPTIONS] <OPERATION>\n\nArguments:\n  <OPERATION>\n          The credential operation: get, store, or erase\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "merge": "Merge another branch, tag or commit into the current branch\n\nUsage: grit merge [OPTIONS] [REV]\n\nArguments:\n  [REV]\n          Branch, tag or commit to merge (any revision, e.g. `v1.2`, a commit id, `topic~2`)\n\nOptions:\n      --abort\n          Cancel an in-progress merge and restore the pre-merge state\n\n      --continue\n          Finish an in-progress merge after resolving conflicts (or after `--no-commit`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --check\n          Predict whether the merge would succeed without changing refs, index, or worktree\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --dry-run\n          Report the planned merge outcome without changing refs, index, or worktree\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --ff-only\n          Refuse when a fast-forward is not possible (exit code 128)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-ff\n          Record a merge commit even when a fast-forward is possible\n\n      --no-commit\n          Apply the merge to the index and worktree but do not commit yet\n\n      --squash\n          Squash merged commits into staged changes and write `SQUASH_MSG`\n\n      --allow-unrelated-histories\n          Merge histories that share no commits (uses the empty tree as merge base)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --no-verify\n          Skip the `pre-merge-commit` and `commit-msg` hooks (`prepare-commit-msg` and `post-merge` still run)\n\n  -X <ours|theirs>\n          Prefer ours or theirs on overlapping edits (`-X ours` / `-X theirs`)\n\n          Possible values:\n          - ours:   Prefer the current branch when both sides changed the same region\n          - theirs: Prefer the branch being merged when both sides changed the same region\n\n      --conflict <CONFLICT_STYLE>\n          Conflict marker style (`merge`, `diff3`, or `zdiff3`)\n\n          Possible values:\n          - merge:  Standard two-section conflict markers\n          - diff3:  Three-section markers including the base section\n          - zdiff3: Zealous diff3 (`zdiff3`)\n\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "merge-base": "Find merge bases or test whether one commit is an ancestor of another\n\nUsage: grit merge-base [OPTIONS] <A> <B>\n\nArguments:\n  <A>\n          First commit or ref\n\n  <B>\n          Second commit or ref\n\nOptions:\n      --all\n          List every minimal merge base (criss-cross histories)\n\n      --is-ancestor\n          Exit 0 when `a` is an ancestor of `b`, 1 otherwise; prints nothing in human mode\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "mv": "Rename or move tracked paths\n\nUsage: grit mv [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Source path(s) and final destination (last argument)\n\nOptions:\n  -f, --force\n          Replace existing files at the destination\n\n      --dry-run\n          List moves that would happen without changing the index or work tree\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "notes": "List, show, add, or remove Git notes on commits\n\nUsage: grit notes [OPTIONS] [COMMAND]\n\nCommands:\n  list    List notes attached to commits\n  show    Show the note for a revision\n  add     Add or replace a note on a revision\n  remove  Remove notes from one or more revisions\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n      --ref <REF>\n          Notes ref (default: `core.notesRef` or `refs/notes/commits`)\n\n      --dry-run\n          Preview `add` or `remove` without writing objects or refs\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "notes add": "Add or replace a note on a revision\n\nUsage: grit notes add [OPTIONS] <REV>\n\nArguments:\n  <REV>\n          Revision to attach the note to\n\nOptions:\n  -m, --message <MESSAGE>\n          Commit message text\n\n      --ref <REF>\n          Notes ref (default: `core.notesRef` or `refs/notes/commits`)\n\n      --dry-run\n          Preview `add` or `remove` without writing objects or refs\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --force\n          Replace an existing note\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "notes help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit notes help [COMMAND]\n\nCommands:\n  list    List notes attached to commits\n  show    Show the note for a revision\n  add     Add or replace a note on a revision\n  remove  Remove notes from one or more revisions\n  help    Print this message or the help of the given subcommand(s)\n",
  "notes help add": "Add or replace a note on a revision\n\nUsage: grit notes help add\n",
  "notes help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit notes help help\n",
  "notes help list": "List notes attached to commits\n\nUsage: grit notes help list\n",
  "notes help remove": "Remove notes from one or more revisions\n\nUsage: grit notes help remove\n",
  "notes help show": "Show the note for a revision\n\nUsage: grit notes help show\n",
  "notes list": "List notes attached to commits\n\nUsage: grit notes list [OPTIONS]\n\nOptions:\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --ref <REF>\n          Notes ref (default: `core.notesRef` or `refs/notes/commits`)\n\n      --dry-run\n          Preview `add` or `remove` without writing objects or refs\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "notes remove": "Remove notes from one or more revisions\n\nUsage: grit notes remove [OPTIONS] [REV]...\n\nArguments:\n  [REV]...\n          Revisions whose notes should be removed\n\nOptions:\n      --ref <REF>\n          Notes ref (default: `core.notesRef` or `refs/notes/commits`)\n\n      --dry-run\n          Preview `add` or `remove` without writing objects or refs\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "notes show": "Show the note for a revision\n\nUsage: grit notes show [OPTIONS] <REV>\n\nArguments:\n  <REV>\n          Commit (or other object) to show the note for\n\nOptions:\n      --ref <REF>\n          Notes ref (default: `core.notesRef` or `refs/notes/commits`)\n\n      --dry-run\n          Preview `add` or `remove` without writing objects or refs\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "patch-id": "Print stable patch-IDs for commits or revision ranges\n\nUsage: grit patch-id [OPTIONS] [REV]...\n\nArguments:\n  [REV]...\n          Commits or ranges to hash; `A..B` and `A...B` expand to one ID per commit (merge commits are skipped)\n\nOptions:\n      --unstable\n          Use legacy unstable patch-ID algorithm (Git 1.9 and older)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "pick": "Cherry-pick commits onto the current branch\n\nUsage: grit pick [OPTIONS] [COMMIT]...\n\nArguments:\n  [COMMIT]...\n          Commits or ranges to pick (`A..B`, branch tips, oids). Omit with `--continue`, `--abort`, or `--skip`\n\nOptions:\n      --mainline <N>\n          Parent number when picking a merge commit (1-based, long only)\n\n      --continue\n          Finish a pick stopped on conflicts or an empty commit\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --abort\n          Cancel an in-progress pick and restore the pre-pick state\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --skip\n          Skip the current pick step and continue with the next commit\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -x, --record-origin\n          Append `(cherry picked from commit …)` to each new commit message\n\n      --no-commit\n          Apply the pick to the index only; do not create a commit yet\n\n      --empty <EMPTY>\n          When a pick step would not change the tree: stop (default), keep an empty commit, or drop the step\n\n          Possible values:\n          - stop: Stop and leave sequencer state for `--continue` / `--skip`\n          - keep: Record an empty commit for the step\n          - drop: Skip the commit and continue with the next one\n          \n          [default: stop]\n\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --check\n          Predict whether the pick would succeed without changing refs, the index, or the worktree\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --dry-run\n          List commits that would be picked without changing refs or the worktree\n\n  -X <OURS|THEIRS>\n          Auto-resolve replay conflicts: `ours` keeps the current branch side, `theirs` keeps the replayed change\n\n          Possible values:\n          - ours:   Favor the upstream / onto side during rebase replay (matches `git rebase -X ours`)\n          - theirs: Favor the commit being replayed (matches `git rebase -X theirs`)\n\n      --conflict <CONFLICT_STYLE>\n          Conflict marker style when a step would stop with conflicts\n\n          Possible values:\n          - merge:  Standard two-section conflict markers\n          - diff3:  Three-section markers including the base section\n          - zdiff3: Zealous diff3 (`zdiff3`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "pull": "Fetch from the remote and integrate it into the current branch.\n\nIn a snapshot checkout, refresh it onto the server's newest snapshot; `grit pull <branch>` brings `<branch>` onto the server's branch of that name, as the checkout sees it.\n\nUsage: grit pull [OPTIONS] [REMOTE] [REFSPEC]...\n\nArguments:\n  [REMOTE]\n          Remote to fetch from (defaults to the current branch's remote, else `origin`)\n\n  [REFSPEC]...\n          Refspecs selecting refs to fetch (`main`, `+refs/heads/x:refs/heads/y`, …)\n\nOptions:\n      --all\n          Fetch from every configured remote (respects `remote.<name>.skipFetchAll`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --tags\n          Fetch all tags from the remote (`git fetch --tags`)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --no-tags\n          Do not fetch tags automatically (`git fetch --no-tags`)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --prune\n          Remove remote-tracking refs that no longer exist on the remote\n\n      --no-prune\n          Do not prune stale remote-tracking refs, even when config enables it\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --dry-run\n          Report ref updates without writing refs or objects\n\n  -q, --quiet\n          Suppress progress and human output\n\n      --depth <N>\n          Fetch only the recent history of each branch (same as `git fetch --depth`)\n\n      --deepen <N>\n          Deepen an existing shallow clone by this many commits (`git fetch --deepen`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --unshallow\n          Convert a shallow repository to a complete one (`git fetch --unshallow`)\n\n  -f, --force\n          Force ref updates that would be rejected (non-fast-forward, tag clobber with `--tags`)\n\n      --ff-only\n          Refuse when a merge would be required (exit 1 when diverged)\n\n      --no-rebase\n          Merge instead of rebasing, overriding `pull.rebase`\n\n      --rebase\n          Rebase local commits onto the fetched upstream, overriding `pull.rebase=false`\n\n      --autostash\n          Stash dirty worktree/index changes around the pull (`merge.autoStash` / `rebase.autoStash`)\n\n      --check\n          Fetch and report whether a fast-forward is possible without changing the branch\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "push": "Publish refs to a remote\n\nUsage: grit push [OPTIONS] [REMOTE] [REFSPEC]...\n\nArguments:\n  [REMOTE]\n          Remote name (when not using `--remote`)\n\n  [REFSPEC]...\n          Refspec (`src`, `src:dst`, `:dst`, …)\n\nOptions:\n  -t, --tags\n          Push tags instead of the current branch. Pushes every local tag under `refs/tags/` to the remote\n\n      --delete\n          Delete the named remote branches or tags instead of pushing\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --all\n          Push every local branch (`refs/heads/*:refs/heads/*`)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --mirror\n          Mirror all refs under `refs/` and delete stale remote refs (implies force)\n\n      --prune\n          Delete remote branch refs that have no local counterpart in this push\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --dry-run\n          Contact the remote but do not update refs or send objects\n\n  -f, --force\n          Overwrite remote refs even when the update is not a fast-forward\n\n      --force-with-lease[=<REV>]\n          Push only when the remote ref matches the local remote-tracking ref, or `=<rev>` when pushing exactly one ref\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -u, --set-upstream\n          Set `branch.<name>.remote` and `branch.<name>.merge` for each pushed branch\n\n      --atomic\n          All ref updates succeed or none are applied\n\n  -o, --push-option <OPTION>\n          Server-side push option (repeatable; `GIT_PUSH_OPTION_*` in hooks)\n\n      --follow-tags\n          Push annotated tags reachable from the commits being pushed\n\n      --no-verify\n          Skip the `pre-push` hook\n\n  -q, --quiet\n          Suppress progress and human output\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "rebase": "Replay local commits onto a new base (atomic ref update)\n\nUsage: grit rebase [OPTIONS] [UPSTREAM]\n\nArguments:\n  [UPSTREAM]\n          Commits to replay are those reachable from `HEAD` but not from this revision (defaults to `@{upstream}`)\n\nOptions:\n      --onto <REV>\n          Replay onto this commit instead of `UPSTREAM`\n\n      --continue\n          Finish a rebase stopped on conflicts after resolving and staging paths\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --abort\n          Cancel an in-progress rebase and restore the branch to its pre-rebase tip\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --skip\n          Skip the current commit and replay the rest\n\n      --check\n          Predict whether the rebase would succeed without changing refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -X <OURS|THEIRS>\n          Auto-resolve replay conflicts: `ours` keeps the onto side, `theirs` keeps replayed commits\n\n          Possible values:\n          - ours:   Favor the upstream / onto side during rebase replay (matches `git rebase -X ours`)\n          - theirs: Favor the commit being replayed (matches `git rebase -X theirs`)\n\n      --exec <CMD>\n          Run a shell command after each replayed commit is checked out (repeatable; incompatible with `--dry-run` and `--check`)\n\n      --no-verify\n          Skip the `pre-rebase` hook\n\n      --fork-point\n          Use the upstream reflog to find where the branch forked (implicit upstream only unless set)\n\n      --no-fork-point\n          Do not use the upstream reflog fork point (merge base only)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --dry-run\n          Print planned ref updates without moving refs (new commit objects are still written)\n\n      --update-refs <UPDATE_REFS>\n          Which refs to rewrite: all descendant branches (default) or only `HEAD`\n\n          Possible values:\n          - branches: Every local branch descending from the edited commit, plus `HEAD` when applicable, except other branches at the `HEAD` commit (backups keep the old history)\n          - head:     Only the commit `HEAD` currently points at\n          \n          [default: branches]\n\n      --empty <EMPTY>\n          When a replayed commit would not change the tree: drop (default), keep an empty commit, or abort\n\n          Possible values:\n          - drop:  Omit commits whose tree matches the new parent\n          - keep:  Keep empty commits\n          - abort: Refuse when a commit would become empty\n          \n          [default: drop]\n\n      --keep-committer\n          Keep each replayed commit's original committer line instead of the configured committer\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "receive-pack": "Accept a push over stdin/stdout (run by ssh and grit-http-server)\n\nUsage: grit receive-pack [OPTIONS] <DIRECTORY>\n\nArguments:\n  <DIRECTORY>\n          The repository to serve\n\nOptions:\n      --stateless-rpc\n          Answer a single request without advertising refs first (smart HTTP)\n\n      --advertise-refs\n          Print the ref advertisement and exit (smart HTTP discovery)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "reflog": "Show, delete, or expire reflog entries\n\nUsage: grit reflog [OPTIONS] [REF] [COMMAND]\n\nCommands:\n  delete  Remove one or more reflog entries (`ref@\n          `)\n  expire  Drop reflog entries older than configured or explicit cutoffs\n  list    List refs that currently have a reflog\n  help    Print this message or the help of the given subcommand(s)\n\nArguments:\n  [REF]\n          Ref to show (defaults to `HEAD`)\n\nOptions:\n  -n, --max-count <N>\n          Show at most this many entries (newest first)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --since <DATE>\n          Exclude entries older than this date (Git `--since`)\n\n      --after <DATE>\n          Alias for `--since`\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --until <DATE>\n          Exclude entries newer than this date (Git `--until`)\n\n      --before <DATE>\n          Alias for `--until`\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --grep <PAT>\n          Keep entries whose message contains this substring (case-sensitive)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "reflog delete": "Remove one or more reflog entries (`ref@\n`)\n\nUsage: grit reflog delete [OPTIONS] <REF@{N}>...\n\nArguments:\n  <REF@{N}>...\n          Reflog selectors (`main@{1}`, `HEAD@{0}`, …)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "reflog expire": "Drop reflog entries older than configured or explicit cutoffs\n\nUsage: grit reflog expire [OPTIONS]\n\nOptions:\n      --all\n          Process every ref under `refs/`, not only refs that already have log files\n\n      --expire <DATE>\n          Expire reachable entries older than this (Git `--expire` syntax)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --expire-unreachable <DATE>\n          Expire unreachable entries older than this\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --dry-run\n          Report what would be pruned without rewriting reflog files\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "reflog help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit reflog help [COMMAND]\n\nCommands:\n  delete  Remove one or more reflog entries (`ref@\n          `)\n  expire  Drop reflog entries older than configured or explicit cutoffs\n  list    List refs that currently have a reflog\n  help    Print this message or the help of the given subcommand(s)\n",
  "reflog help delete": "Remove one or more reflog entries (`ref@\n`)\n\nUsage: grit reflog help delete\n",
  "reflog help expire": "Drop reflog entries older than configured or explicit cutoffs\n\nUsage: grit reflog help expire\n",
  "reflog help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit reflog help help\n",
  "reflog help list": "List refs that currently have a reflog\n\nUsage: grit reflog help list\n",
  "reflog list": "List refs that currently have a reflog\n\nUsage: grit reflog list [OPTIONS]\n\nOptions:\n  -n, --limit <N>\n          Return at most this many ref names (sorted)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote": "List remotes, or add one\n\nUsage: grit remote [OPTIONS] [COMMAND]\n\nCommands:\n  add       Add a new remote\n  set-url   Set the fetch or push URL for an existing remote\n  remove    Remove a remote and its remote-tracking refs\n  prune     Delete stale remote-tracking refs without fetching\n  set-head  Set or delete `refs/remotes/<name>/HEAD`\n  show      Summarize a remote (URLs, branches, pull config)\n  rename    Rename an existing remote\n  refs      List references on a remote (like `git ls-remote`)\n  help      Print this message or the help of the given subcommand(s)\n\nOptions:\n  -v, --verbose\n          Show fetch and push URLs (like `git remote -v`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote add": "Add a new remote\n\nUsage: grit remote add [OPTIONS] <NAME> <URL>\n\nArguments:\n  <NAME>\n          Short name for the remote (e.g. origin)\n\n  <URL>\n          The remote's URL or path\n\nOptions:\n      --fetch\n          Fetch from the remote after adding it\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit remote help [COMMAND]\n\nCommands:\n  add       Add a new remote\n  set-url   Set the fetch or push URL for an existing remote\n  remove    Remove a remote and its remote-tracking refs\n  prune     Delete stale remote-tracking refs without fetching\n  set-head  Set or delete `refs/remotes/<name>/HEAD`\n  show      Summarize a remote (URLs, branches, pull config)\n  rename    Rename an existing remote\n  refs      List references on a remote (like `git ls-remote`)\n  help      Print this message or the help of the given subcommand(s)\n",
  "remote help add": "Add a new remote\n\nUsage: grit remote help add\n",
  "remote help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit remote help help\n",
  "remote help prune": "Delete stale remote-tracking refs without fetching\n\nUsage: grit remote help prune\n",
  "remote help refs": "List references on a remote (like `git ls-remote`)\n\nUsage: grit remote help refs\n",
  "remote help remove": "Remove a remote and its remote-tracking refs\n\nUsage: grit remote help remove\n",
  "remote help rename": "Rename an existing remote\n\nUsage: grit remote help rename\n",
  "remote help set-head": "Set or delete `refs/remotes/<name>/HEAD`\n\nUsage: grit remote help set-head\n",
  "remote help set-url": "Set the fetch or push URL for an existing remote\n\nUsage: grit remote help set-url\n",
  "remote help show": "Summarize a remote (URLs, branches, pull config)\n\nUsage: grit remote help show\n",
  "remote prune": "Delete stale remote-tracking refs without fetching\n\nUsage: grit remote prune [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          Configured remote name\n\nOptions:\n      --dry-run\n          Report refs that would be pruned without deleting them\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote refs": "List references on a remote (like `git ls-remote`)\n\nUsage: grit remote refs [OPTIONS] <REMOTE_OR_URL> [PREFIX]...\n\nArguments:\n  <REMOTE_OR_URL>\n          Configured remote name or a literal URL/path\n\n  [PREFIX]...\n          Optional ref prefixes (same rules as `git ls-remote`)\n\nOptions:\n      --heads\n          Only show refs under `refs/heads/`\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --tags\n          Only show refs under `refs/tags/`\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --sort <KEY>\n          Sort refs by `name` or `version` (`git ls-remote --sort=version:refname`)\n\n          Possible values:\n          - name:    Full ref name order\n          - version: Numeric `version:refname` order\n          \n          [default: name]\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --reverse\n          Reverse sort order (`git ls-remote --sort=-…`)\n\n  -n, --limit <N>\n          Return at most this many refs after sorting\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote remove": "Remove a remote and its remote-tracking refs\n\nUsage: grit remote remove [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          Remote name to remove\n\nOptions:\n      --dry-run\n          Report changes without writing config or refs\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote rename": "Rename an existing remote\n\nUsage: grit remote rename [OPTIONS] <OLD> <NEW>\n\nArguments:\n  <OLD>\n          Current remote name\n\n  <NEW>\n          New remote name\n\nOptions:\n      --dry-run\n          Show what would change without writing the repository\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote set-head": "Set or delete `refs/remotes/<name>/HEAD`\n\nUsage: grit remote set-head [OPTIONS] <NAME> [BRANCH]\n\nArguments:\n  <NAME>\n          Configured remote name\n\n  [BRANCH]\n          Short branch name (sets HEAD to `refs/remotes/<name>/<branch>`)\n\nOptions:\n      --auto\n          Query the remote and set HEAD from its default branch\n\n      --delete\n          Delete the local HEAD symref\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --dry-run\n          Show what would change without updating refs\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote set-url": "Set the fetch or push URL for an existing remote\n\nUsage: grit remote set-url [OPTIONS] <NAME> <URL>\n\nArguments:\n  <NAME>\n          Remote to update\n\n  <URL>\n          New URL or path\n\nOptions:\n      --push\n          Update `pushurl` instead of `url`\n\n      --dry-run\n          Show what would change without writing config\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "remote show": "Summarize a remote (URLs, branches, pull config)\n\nUsage: grit remote show [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          Configured remote name\n\nOptions:\n      --no-query\n          Use local remote-tracking refs only; do not contact the remote\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -n, --limit <N>\n          Return at most this many remote branches\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "repack": "Pack reachable objects and remove redundant packs\n\nUsage: grit repack [OPTIONS]\n\nOptions:\n  -f, --force\n          Recompute every delta instead of reusing the ones already in packs\n\n      --dry-run\n          Show what would be packed without writing\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -q, --quiet\n          Suppress progress summary on stderr\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "reset": "Move the branch tip and optionally reset the index or worktree\n\nUsage: grit reset [OPTIONS] [REV]\n\nArguments:\n  [REV]\n          Commit to reset to (defaults to `HEAD`)\n\nOptions:\n      --soft\n          Keep the index and worktree; move the branch tip only\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --mixed\n          Reset the index to the target commit; keep the worktree (default)\n\n      --hard\n          Reset the index and worktree to match the target commit\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --keep\n          Reset the tip and update differing paths while keeping unrelated local edits\n\n      --dry-run\n          Preview the reset without updating refs, the index, or the worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -n, --limit <N>\n          Maximum orphaned commits to list in `--json` output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "resolve": "Resolve revision specs to object ids and types\n\nUsage: grit resolve [OPTIONS] [SPEC]...\n\nArguments:\n  [SPEC]...\n          Revision specs to resolve (same forms as history commands)\n\nOptions:\n      --short\n          Print abbreviated object ids\n\n      --abbrev-ref\n          Print the shortest unambiguous ref name for each spec (like `git rev-parse --abbrev-ref`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --symbolic-full-name\n          Print the full symbolic ref name for each spec (like `git rev-parse --symbolic-full-name`)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --verify <SPEC>\n          Resolve exactly one spec strictly (`git rev-parse --verify`); pass the spec as the flag value\n\n  -q, --quiet\n          With `--verify`, answer yes/no via exit status only (no stdout/stderr)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "restore": "Restore working tree and/or index paths\n\nUsage: grit restore [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Files or directories to limit the command to\n\nOptions:\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -S, --staged\n          Restore the index from HEAD (or `--source`)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n  -W, --worktree\n          Restore the working tree (default when `--staged` is absent)\n\n  -s, --source <SOURCE>\n          Tree or commit to restore from\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --ours\n          For unmerged paths, write our side (index stage 2) into the worktree\n\n      --theirs\n          For unmerged paths, write their side (index stage 3) into the worktree\n\n      --merge\n          Rebuild conflict markers in the worktree from index stages\n\n      --conflict <CONFLICT_STYLE>\n          Conflict marker style (implies `--merge`)\n\n          Possible values:\n          - merge:  Standard two-section conflict markers\n          - diff3:  Three-section markers including the base section\n          - zdiff3: Zealous diff3 (`zdiff3`)\n\n      --hunks <ID,...>\n          Discard only the listed unstaged hunk ids (`grit diff --unstaged --json`) or unstage staged ids (`--staged`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --lines <PATH:START-END>\n          Discard or unstage only new-side line ranges (`path:start-end` from `grit diff --json`)\n\n      --dry-run\n          Report paths that would change without writing the worktree or index\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "revert": "Undo commits with new inverse commits\n\nUsage: grit revert [OPTIONS] [COMMIT]...\n\nArguments:\n  [COMMIT]...\n          Commits or revision ranges to revert (newest first within each range)\n\nOptions:\n      --mainline <N>\n          Parent number when reverting a merge commit (1-based, long only)\n\n      --continue\n          Finish a revert stopped on conflicts or an empty commit\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --abort\n          Cancel an in-progress revert and restore the pre-revert state\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --skip\n          Skip the current revert step and continue with the next commit\n\n      --no-commit\n          Apply the revert to the index only; do not create a commit yet\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --empty <EMPTY>\n          When a revert step would not change the tree: stop (default), keep an empty commit, or drop the step\n\n          Possible values:\n          - stop: Stop and leave sequencer state for `--continue` / `--skip`\n          - keep: Record an empty commit for the step\n          - drop: Skip the commit and continue with the next one\n          \n          [default: stop]\n\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --check\n          Predict whether the revert would succeed without changing refs, the index, or the worktree\n\n      --dry-run\n          List commits that would be reverted without changing refs or the worktree\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -X <OURS|THEIRS>\n          Auto-resolve replay conflicts: `ours` keeps the current branch side, `theirs` keeps the replayed change\n\n          Possible values:\n          - ours:   Favor the upstream / onto side during rebase replay (matches `git rebase -X ours`)\n          - theirs: Favor the commit being replayed (matches `git rebase -X theirs`)\n\n      --conflict <CONFLICT_STYLE>\n          Conflict marker style when a step would stop with conflicts\n\n          Possible values:\n          - merge:  Standard two-section conflict markers\n          - diff3:  Three-section markers including the base section\n          - zdiff3: Zealous diff3 (`zdiff3`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "revs": "List or count commits matching revision ranges\n\nUsage: grit revs [OPTIONS] [REV]... [-- <PATH>...]\n\nArguments:\n  [REV]...\n          Revision tips and ranges (`A..B`, `A...B`, `^tip`, plain tips)\n\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --skip <SKIP>\n          Skip this many commits after ordering\n          \n          [default: 0]\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --since <DATE>\n          Exclude commits older than this date (Git `--since`)\n\n      --after <DATE>\n          Alias for `--since`\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --until <DATE>\n          Exclude commits newer than this date (Git `--until`)\n\n      --before <DATE>\n          Alias for `--until` (date cutoff)\n\n      --first-parent\n          Follow only the first parent at merges\n\n      --follow\n          Follow a single file path across renames (Git `log --follow`)\n\n      --merges\n          Include only merge commits\n\n      --no-merges\n          Exclude merge commits\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --reverse\n          Reverse commit order (oldest first)\n\n      --all\n          Include every ref tip\n\n      --branches [<GLOB>]\n          Include branch tips, or those matching an optional glob\n\n      --tags [<GLOB>]\n          Include tag tips, or those matching an optional glob\n\n      --remotes [<GLOB>]\n          Include remote-tracking tips, or those matching an optional glob\n\n      --author <PAT>\n          Limit to commits whose author matches this pattern (repeatable; OR together)\n\n      --committer <PAT>\n          Limit to commits whose committer matches this pattern (repeatable; OR together)\n\n      --grep <PAT>\n          Limit to commits whose message matches this pattern (repeatable; OR unless `--all-match`)\n\n  -i, --regexp-ignore-case\n          Case-insensitive pattern matching for `--author`, `--committer`, and `--grep`\n\n      --all-match\n          Require every `--grep` pattern to match\n\n      --invert-grep\n          Invert `--grep` matching (commits that do not match the grep group)\n\n  -F, --fixed-strings\n          Treat `--author`, `--committer`, and `--grep` patterns as fixed strings\n\n      --no-mailmap\n          Do not apply `.mailmap` when matching `--author` or `--committer`\n\n  -S <STRING>\n          Keep commits where occurrence count of this string changed (`git log -S`)\n\n  -G <PAT>\n          Keep commits whose added/removed lines match this pattern (`git log -G`)\n\n      --pickaxe-regex\n          Treat `-S` as a BRE instead of a literal string (`--pickaxe-regex`)\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --count\n          Print only the number of reachable commits\n\n      --left-right\n          Mark each commit of a symmetric range (`A...B`) as left or right; with `--count`, print left/right counts instead\n\n      --cherry-mark\n          Pair the two sides of a symmetric range (`A...B`) by patch-id and mark equivalent commits (implies `--left-right`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "rm": "Remove tracked paths from the working tree and index\n\nUsage: grit rm [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Files or directories to limit the command to\n\nOptions:\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --cached\n          Remove from the index only; keep files in the working tree\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -f, --force\n          Remove even when paths have local modifications\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --dry-run\n          List paths that would be removed without changing the index or work tree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --ignore-unmatch\n          Treat non-matching pathspecs as success with an empty result\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "root": "A simple Grit-powered CLI\n\nUsage: grit [OPTIONS] [COMMAND]\n\nCommands:\n  init         Create a new, empty repository\n  checkout     Start work on a repository from a snapshot of its main branch (or some of its paths) instead of a clone\n  checkin      Send a snapshot checkout's branches back to the server, grafted onto its real history\n  integrate    Merge a branch into the server's target branch (checking it in first), then refresh this checkout\n  sync         Push and pull every active branch between this clone and your space on the server (GitButler Code)\n  share        Work on a branch together with other users of the server: each has their own head of it\n  slice        Named sets of paths to check out together, kept on the server's target branch\n  clone        Copy a remote repository into a new directory\n  remote       List remotes, or add one\n  log          Show recent commits reachable from HEAD\n  revs         List or count commits matching revision ranges\n  merge-base   Find merge bases or test whether one commit is an ancestor of another\n  reflog       Show, delete, or expire reflog entries\n  blame        Show who last modified each line of a file\n  describe     Nearest reachable tag, exact commit distance, and abbreviated id for a revision\n  diff         Show changes as a diff. No argument: uncommitted changes; with a commit: the change that commit introduced; with two commits (or `A..B`) diff their trees\n  show         Show information about a commit, tag, or branch (defaults to HEAD)\n  status       Show what's changed and where you are (this is the default)\n  shortlog     List the commits on this branch that aren't on the target branch yet [alias: ahead]\n  add          Stage changes. With no paths, stages everything\n  rm           Remove tracked paths from the working tree and index\n  mv           Rename or move tracked paths\n  clean        Remove untracked files from the working tree\n  repack       Pack reachable objects and remove redundant packs\n  gc           Pack refs, expire reflogs, repack, prune, and refresh commit-graph\n  fsck         Check refs, objects, and pack indexes for problems\n  ignore       Query exclude (gitignore) rules\n  hooks        List hook scripts or run one by name\n  patch-id     Print stable patch-IDs for commits or revision ranges\n  resolve      Resolve revision specs to object ids and types\n  cat          Show blob, tree, commit, or tag contents for a revision spec\n  commit       Stage every change and record a new commit\n  branch       List branches, or create / delete / rename / configure one\n  switch       Switch to another branch, remote branch, or detached commit\n  reset        Move the branch tip and optionally reset the index or worktree\n  merge        Merge another branch, tag or commit into the current branch\n  pick         Cherry-pick commits onto the current branch\n  revert       Undo commits with new inverse commits\n  history      Rewrite commits without a sequencer (plan, then apply refs atomically)\n  stash        Save or restore shelved work\n  restore      Restore working tree and/or index paths\n  fetch        Download refs and objects from a remote\n  pull         Fetch from the remote and integrate it into the current branch\n  rebase       Replay local commits onto a new base (atomic ref update)\n  push         Publish refs to a remote\n  bundle       Create, verify, or list git bundle files\n  notes        List, show, add, or remove Git notes on commits\n  tag          List tags, or create / delete one\n  worktree     List, add, or remove linked worktrees\n  auth         Sign in to GitButler Code (GitHub inside a github.com repository), a `grit serve` host, or store a username and token for any HTTPS host [alias: login]\n  update       Update grit to the latest release (re-runs the install script)\n  skill        Print an agent skill (SKILL.md) that explains how to use grit\n  completions  Generate shell completion scripts for bash, zsh, or fish\n  config       Read, set, or list configuration values\n  manager      Git credential helper backed by the Windows Credential Manager\n  serve        Serve repositories over HTTP, with a web view where people sign in with email and password\n  help         Print this message or the help of the given subcommand(s)\n\nOptions:\n  -v, --version\n          Print version\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -C <DIR>\n          Run as if grit was started in DIR (repeatable; each one is relative to the previous)\n\n  -c <KEY=VALUE>\n          Set a config value for this invocation only (repeatable; a bare KEY means true)\n\n      --git-dir <PATH>\n          Use this repository directory instead of discovering one (same as `GIT_DIR`)\n\n      --work-tree <PATH>\n          Use this directory as the work tree root (same as `GIT_WORK_TREE`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "serve": "Serve repositories over HTTP, with a web view where people sign in with email and password\n\nUsage: grit serve [OPTIONS] [COMMAND]\n\nCommands:\n  add-user  Add a user. Prompts for their password, or generates a temporary one\n  token     Create an access token for a user, for scripts and CI that cannot sign in in a browser\n  grant     Give a user read access to a repository (or write access with `--write`)\n  users     List users, their tokens and their repository access\n  help      Print this message or the help of the given subcommand(s)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --root <PATH>\n          A repository, or a directory of repositories, to serve\n          \n          [default: .]\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --db <FILE>\n          The user database (default: `grit-serve.db` in the root, or in its `.git`)\n\n      --bind <HOST:PORT>\n          Address to listen on\n          \n          [default: 127.0.0.1:8080]\n\n      --setup\n          Create the user database and its first admin user, then exit. Prompts for a password (or generates one)\n\n      --email <EMAIL>\n          Email address of the admin `--setup` creates (asked for when omitted)\n\n      --bundle-interval <DURATION>\n          How often to rebuild a changed repository's clone bundle, like `24h`, `30m` or `2d`\n          \n          [default: 24h]\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --no-bundles\n          Do not build or offer clone bundles\n\n      --header-timeout <DURATION>\n          Maximum time to wait for complete request headers on Git connections\n          \n          [default: 30s]\n\n      --idle-timeout <DURATION>\n          Drop Git requests whose body or upload-pack response stalls this long between chunks\n          \n          [default: 60s]\n\n      --max-git-requests <N>\n          Concurrent Git smart-HTTP requests before new ones get HTTP 503\n          \n          [default: 128]\n\n      --shutdown-timeout <DURATION>\n          After SIGTERM, SIGINT or SIGHUP, keep serving in-flight requests for this long before closing remaining connections (`0s` waits until they finish)\n          \n          [default: 30s]\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "serve add-user": "Add a user. Prompts for their password, or generates a temporary one\n\nUsage: grit serve add-user [OPTIONS] <EMAIL>\n\nArguments:\n  <EMAIL>\n          The user's email address, which is also their user name\n\nOptions:\n      --admin\n          Make the user an admin, with read and write access to every repository\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --root <PATH>\n          A repository, or a directory of repositories, to serve\n          \n          [default: .]\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --db <FILE>\n          The user database (default: `grit-serve.db` in the root, or in its `.git`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "serve grant": "Give a user read access to a repository (or write access with `--write`)\n\nUsage: grit serve grant [OPTIONS] <USER> <REPOSITORY>\n\nArguments:\n  <USER>\n          The email address of the user to give access to\n\n  <REPOSITORY>\n          The repository name, with or without `.git`\n\nOptions:\n      --write\n          Allow pushing as well as fetching\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --root <PATH>\n          A repository, or a directory of repositories, to serve\n          \n          [default: .]\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --db <FILE>\n          The user database (default: `grit-serve.db` in the root, or in its `.git`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "serve help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit serve help [COMMAND]\n\nCommands:\n  add-user  Add a user. Prompts for their password, or generates a temporary one\n  token     Create an access token for a user, for scripts and CI that cannot sign in in a browser\n  grant     Give a user read access to a repository (or write access with `--write`)\n  users     List users, their tokens and their repository access\n  help      Print this message or the help of the given subcommand(s)\n",
  "serve help add-user": "Add a user. Prompts for their password, or generates a temporary one\n\nUsage: grit serve help add-user\n",
  "serve help grant": "Give a user read access to a repository (or write access with `--write`)\n\nUsage: grit serve help grant\n",
  "serve help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit serve help help\n",
  "serve help token": "Create an access token for a user, for scripts and CI that cannot sign in in a browser\n\nUsage: grit serve help token\n",
  "serve help users": "List users, their tokens and their repository access\n\nUsage: grit serve help users\n",
  "serve token": "Create an access token for a user, for scripts and CI that cannot sign in in a browser\n\nUsage: grit serve token [OPTIONS] <EMAIL>\n\nArguments:\n  <EMAIL>\n          The user's email address\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --root <PATH>\n          A repository, or a directory of repositories, to serve\n          \n          [default: .]\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --db <FILE>\n          The user database (default: `grit-serve.db` in the root, or in its `.git`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "serve users": "List users, their tokens and their repository access\n\nUsage: grit serve users [OPTIONS]\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --root <PATH>\n          A repository, or a directory of repositories, to serve\n          \n          [default: .]\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --db <FILE>\n          The user database (default: `grit-serve.db` in the root, or in its `.git`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share": "Work on a branch together with other users of the server: each has their own head of it\n\nUsage: grit share [OPTIONS] <COMMAND>\n\nCommands:\n  add      Share a branch of your space with people, or make a share link\n  list     List your shared branches, and where each member's head is\n  accept   Accept a share link, and fetch the branch (or clone your copy)\n  remove   Remove people from a shared branch, or end its share when you name nobody\n  leave    Leave a shared branch; your head stays a branch in your space\n  resolve  Put your head and another member's back together after they diverged\n  revoke   Revoke a share link\n  help     Print this message or the help of the given subcommand(s)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share accept": "Accept a share link, and fetch the branch (or clone your copy)\n\nUsage: grit share accept [OPTIONS] <LINK>\n\nArguments:\n  <LINK>\n          The link, `https://<server>/share/<token>`\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share add": "Share a branch of your space with people, or make a share link\n\nUsage: grit share add [OPTIONS] <BRANCH> [USER|EMAIL]...\n\nArguments:\n  <BRANCH>\n          The branch (pushed to your space first when it isn't there yet)\n\n  [USER|EMAIL]...\n          User names or email addresses to share it with; each is emailed. An address without an account is invited to sign up and join\n\nOptions:\n      --link\n          Make a share link anyone signed in can accept\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --uses <N>\n          How many times the link can be accepted: a number, or `unlimited` (default 1)\n\n      --expires <DAYS>\n          How many days the link works, up to 30 (default 7)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --no-history\n          Share the branch's own history only, on a snapshot of the base branch, without the rest of the project's history\n\n      --path <PATH>\n          Share only this path of the tree (implies --no-history). Repeatable\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit share help [COMMAND]\n\nCommands:\n  add      Share a branch of your space with people, or make a share link\n  list     List your shared branches, and where each member's head is\n  accept   Accept a share link, and fetch the branch (or clone your copy)\n  remove   Remove people from a shared branch, or end its share when you name nobody\n  leave    Leave a shared branch; your head stays a branch in your space\n  resolve  Put your head and another member's back together after they diverged\n  revoke   Revoke a share link\n  help     Print this message or the help of the given subcommand(s)\n",
  "share help accept": "Accept a share link, and fetch the branch (or clone your copy)\n\nUsage: grit share help accept\n",
  "share help add": "Share a branch of your space with people, or make a share link\n\nUsage: grit share help add\n",
  "share help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit share help help\n",
  "share help leave": "Leave a shared branch; your head stays a branch in your space\n\nUsage: grit share help leave\n",
  "share help list": "List your shared branches, and where each member's head is\n\nUsage: grit share help list\n",
  "share help remove": "Remove people from a shared branch, or end its share when you name nobody\n\nUsage: grit share help remove\n",
  "share help resolve": "Put your head and another member's back together after they diverged\n\nUsage: grit share help resolve\n",
  "share help revoke": "Revoke a share link\n\nUsage: grit share help revoke\n",
  "share leave": "Leave a shared branch; your head stays a branch in your space\n\nUsage: grit share leave [OPTIONS] <BRANCH>\n\nArguments:\n  <BRANCH>\n          The shared branch\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share list": "List your shared branches, and where each member's head is\n\nUsage: grit share list [OPTIONS] [BRANCH]\n\nArguments:\n  [BRANCH]\n          Only this branch\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share remove": "Remove people from a shared branch, or end its share when you name nobody\n\nUsage: grit share remove [OPTIONS] <BRANCH> [USER|EMAIL]...\n\nArguments:\n  <BRANCH>\n          The shared branch\n\n  [USER|EMAIL]...\n          User names to remove, or email addresses whose invitations to withdraw\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share resolve": "Put your head and another member's back together after they diverged\n\nUsage: grit share resolve [OPTIONS] <BRANCH> [OPTION] [NAME]\n\nArguments:\n  <BRANCH>\n          The shared branch\n\n  [OPTION]\n          The option to apply, such as `combine` or `keep_both` (default: `combine`, when nothing would be lost; otherwise the options are listed). For a branch pushed again after it was integrated: `rebase`, `rename` or `reshare`\n\n  [NAME]\n          For `rename`: the branch's new name\n\nOptions:\n      --with <USER>\n          The member whose head to resolve with (needed when several diverged)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "share revoke": "Revoke a share link\n\nUsage: grit share revoke [OPTIONS] <BRANCH> <LINK>\n\nArguments:\n  <BRANCH>\n          The shared branch\n\n  <LINK>\n          The link's id, from `grit share list`\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "shortlog": "List the commits on this branch that aren't on the target branch yet\n\nUsage: grit shortlog [OPTIONS]\n\nOptions:\n      --target <REF>\n          Compare against this ref or revision instead of the discovered target branch\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -n, --max-count <MAX_COUNT>\n          Maximum commits to list on each side (`ahead`, and with `--behind` the behind list too)\n          \n          [default: 100]\n\n      --behind\n          Also list commits on the target that are not on this branch yet\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --stat\n          Summary with change bars per file (like `git log --stat`)\n\n      --name-only\n          Paths only, one per line\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "show": "Show information about a commit, tag, or branch (defaults to HEAD)\n\nUsage: grit show [OPTIONS] [OBJECT]... [-- <PATH>...]\n\nArguments:\n  [OBJECT]...\n          Commits, tags, branches, or `rev:path` specs to show\n\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n      --diff-merges <MODE>\n          Merge commit diffs: `combined` (default) or `first-parent`\n          \n          [default: combined]\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n  -p, --patch\n          Unified patch for each commit (`git log -p`)\n\n      --stat\n          Summary with change bars per file (like `git diff --stat`)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --numstat\n          Machine-readable `insertions<TAB>deletions<TAB>path` lines\n\n      --shortstat\n          Only the summary line (`N files changed, …`)\n\n      --name-only\n          Paths only, one per line\n\n      --name-status\n          Status letter and path(s) per line\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --patch-text\n          Git-apply-compatible unified patch (`git diff --binary` shape); not combinable with `--json`\n\n  -U, --unified <N>\n          Lines of context around each change (Git `-U`)\n\n  -W, --function-context\n          Expand hunks to enclosing function boundaries (Git `-W` / `--function-context`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "skill": "Print an agent skill (SKILL.md) that explains how to use grit\n\nUsage: grit skill [OPTIONS]\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "slice": "Named sets of paths to check out together, kept on the server's target branch\n\nUsage: grit slice [OPTIONS] <COMMAND>\n\nCommands:\n  list    List the slices\n  new     Make a slice\n  edit    Add paths to a slice or remove them\n  delete  Delete a slice\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --url <URL>\n          The repository whose slices to use (default: the checkout you are in)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "slice delete": "Delete a slice\n\nUsage: grit slice delete [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          The slice's name\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --url <URL>\n          The repository whose slices to use (default: the checkout you are in)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "slice edit": "Add paths to a slice or remove them\n\nUsage: grit slice edit [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          The slice's name\n\nOptions:\n      --add <PATH>\n          A path to add (repeatable)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --remove <PATH>\n          A path to remove (repeatable)\n\n  -d, --description <TEXT>\n          A new description\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --url <URL>\n          The repository whose slices to use (default: the checkout you are in)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "slice help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit slice help [COMMAND]\n\nCommands:\n  list    List the slices\n  new     Make a slice\n  edit    Add paths to a slice or remove them\n  delete  Delete a slice\n  help    Print this message or the help of the given subcommand(s)\n",
  "slice help delete": "Delete a slice\n\nUsage: grit slice help delete\n",
  "slice help edit": "Add paths to a slice or remove them\n\nUsage: grit slice help edit\n",
  "slice help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit slice help help\n",
  "slice help list": "List the slices\n\nUsage: grit slice help list\n",
  "slice help new": "Make a slice\n\nUsage: grit slice help new\n",
  "slice list": "List the slices\n\nUsage: grit slice list [OPTIONS]\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --url <URL>\n          The repository whose slices to use (default: the checkout you are in)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "slice new": "Make a slice\n\nUsage: grit slice new [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          The slice's name\n\nOptions:\n  -p, --path <PATH>\n          A path in the slice (repeatable)\n\n  -d, --description <TEXT>\n          What the slice is for\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --url <URL>\n          The repository whose slices to use (default: the checkout you are in)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash": "Save or restore shelved work\n\nUsage: grit stash [OPTIONS] [-- <PATH>...] [COMMAND]\n\nCommands:\n  push    Save local changes to the stash and reset the working tree\n  list    List stash entries\n  show    Show the summary or patch for a stash entry\n  branch  Create a branch at the stash base commit and apply the stash with `--index`\n  clear   Remove every stash entry\n  apply   Apply a stash entry without removing it\n  pop     Apply a stash entry and remove it when there are no conflicts\n  drop    Remove a stash entry without applying it\n  help    Print this message or the help of the given subcommand(s)\n\nArguments:\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files (bare `grit stash` / `grit stash push`)\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash apply": "Apply a stash entry without removing it\n\nUsage: grit stash apply [OPTIONS] [INDEX]\n\nArguments:\n  [INDEX]\n          Stash index (`0` is newest) or `stash@\n          `\n\nOptions:\n      --index\n          Restore the stashed index as well as the worktree\n\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files (bare `grit stash` / `grit stash push`)\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash branch": "Create a branch at the stash base commit and apply the stash with `--index`\n\nUsage: grit stash branch [OPTIONS] <NAME> [INDEX]\n\nArguments:\n  <NAME>\n          New branch name\n\n  [INDEX]\n          Stash index (`0` is newest) or `stash@\n          `\n\nOptions:\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files (bare `grit stash` / `grit stash push`)\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash clear": "Remove every stash entry\n\nUsage: grit stash clear [OPTIONS]\n\nOptions:\n      --force\n          Delete all stash entries (required)\n\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --dry-run\n          Report how many entries would be cleared without deleting\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files (bare `grit stash` / `grit stash push`)\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash drop": "Remove a stash entry without applying it\n\nUsage: grit stash drop [OPTIONS] [INDEX]\n\nArguments:\n  [INDEX]\n          Stash index (`0` is newest) or `stash@\n          `\n\nOptions:\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files (bare `grit stash` / `grit stash push`)\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit stash help [COMMAND]\n\nCommands:\n  push    Save local changes to the stash and reset the working tree\n  list    List stash entries\n  show    Show the summary or patch for a stash entry\n  branch  Create a branch at the stash base commit and apply the stash with `--index`\n  clear   Remove every stash entry\n  apply   Apply a stash entry without removing it\n  pop     Apply a stash entry and remove it when there are no conflicts\n  drop    Remove a stash entry without applying it\n  help    Print this message or the help of the given subcommand(s)\n",
  "stash help apply": "Apply a stash entry without removing it\n\nUsage: grit stash help apply\n",
  "stash help branch": "Create a branch at the stash base commit and apply the stash with `--index`\n\nUsage: grit stash help branch\n",
  "stash help clear": "Remove every stash entry\n\nUsage: grit stash help clear\n",
  "stash help drop": "Remove a stash entry without applying it\n\nUsage: grit stash help drop\n",
  "stash help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit stash help help\n",
  "stash help list": "List stash entries\n\nUsage: grit stash help list\n",
  "stash help pop": "Apply a stash entry and remove it when there are no conflicts\n\nUsage: grit stash help pop\n",
  "stash help push": "Save local changes to the stash and reset the working tree\n\nUsage: grit stash help push\n",
  "stash help show": "Show the summary or patch for a stash entry\n\nUsage: grit stash help show\n",
  "stash list": "List stash entries\n\nUsage: grit stash list [OPTIONS]\n\nOptions:\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files (bare `grit stash` / `grit stash push`)\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash pop": "Apply a stash entry and remove it when there are no conflicts\n\nUsage: grit stash pop [OPTIONS] [INDEX]\n\nArguments:\n  [INDEX]\n          Stash index (`0` is newest) or `stash@\n          `\n\nOptions:\n      --index\n          Restore the stashed index as well as the worktree\n\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files (bare `grit stash` / `grit stash push`)\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash push": "Save local changes to the stash and reset the working tree\n\nUsage: grit stash push [OPTIONS] [-- <PATH>...]\n\nArguments:\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n  -m, --message <MESSAGE>\n          Stash message\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files in the stash\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json`\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD`\n\n  -k, --keep-index\n          Leave staged content in the index and worktree after stashing\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "stash show": "Show the summary or patch for a stash entry\n\nUsage: grit stash show [OPTIONS] [INDEX]\n\nArguments:\n  [INDEX]\n          Stash index (`0` is newest) or `stash@\n          `\n\nOptions:\n  -m, --message <MESSAGE>\n          Stash message (bare `grit stash` / `grit stash push`)\n\n      --stat\n          Show a diffstat summary (default)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -p, --patch\n          Show the full patch instead of a diffstat\n\n      --hunks <ID,...>\n          Stash only unstaged hunks from `grit diff --json` (comma-separated, repeatable)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -u, --include-untracked\n          Include untracked files from the stash U parent\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lines <PATH:START-END>\n          Stash only unstaged line ranges (`path:start-end`, same as `grit add --lines`)\n\n      --dry-run\n          Preview stash without updating refs, index, or worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -S, --staged\n          Stash only index changes vs `HEAD` (unstaged edits on other paths remain)\n\n  -k, --keep-index\n          After stashing, leave the index and worktree matching staged content\n\n  -n, --limit <N>\n          Cap path lists in `--dry-run` preview output\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "status": "Show what's changed and where you are (this is the default)\n\nUsage: grit status [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Files or directories to limit the command to\n\nOptions:\n      --untracked <MODE>\n          How untracked paths are listed: `normal` (default) collapses wholly untracked directories; `all` lists every file; `no` omits untracked paths. When omitted, uses `status.showUntrackedFiles` from config\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --no-ahead-behind\n          Skip ahead/behind rev-list walks (also when `status.aheadBehind=false`)\n\n      --ignored\n          List ignored paths (traditional mode; same set as `git status --ignored`)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n  -s, --short\n          One line per path: two-letter index/worktree code plus path (`??` / `!!` for untracked / ignored)\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "switch": "Switch to another branch, remote branch, or detached commit\n\nUsage: grit switch [OPTIONS] [NAME] [START_POINT]\n\nArguments:\n  [NAME]\n          Branch to switch to, revision with `--detach`, or new branch name with `-c`\n\n  [START_POINT]\n          With `-c`, the commit to start the branch from (defaults to `HEAD`)\n\nOptions:\n  -c, --create\n          Create the branch first, then switch to it\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -t, --track\n          Configure upstream from the start point when creating with `-c`\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --no-track\n          Do not configure upstream when creating with `-c`\n\n      --detach\n          Check out a commit in detached HEAD mode\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --dry-run\n          Run overwrite checks without updating refs, the index, or the worktree\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "sync": "Push and pull every active branch between this clone and your space on the server (GitButler Code)\n\nUsage: grit sync [OPTIONS]\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "tag": "List tags, or create / delete one\n\nUsage: grit tag [OPTIONS] [NAME] [TARGET] [-- <TAG>...]\n\nArguments:\n  [NAME]\n          Name of the tag to create. Omit to list tags\n\n  [TARGET]\n          Revision to tag (default `HEAD`)\n\n  [TAG]...\n          Tag names to verify (one or more, with `--verify`)\n\nOptions:\n  -l, --list [<PATTERN>]\n          List tags matching `PATTERN` (repeatable). Omit `PATTERN` to list all tags\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --sort <SORT>\n          Sort listed tags by version, date, or name\n\n          Possible values:\n          - version: `version:refname` (default)\n          - date:    Creator date (tagger or committer)\n          - name:    Ref name\n          \n          [default: version]\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --reverse\n          Reverse the sort order\n\n      --contains [<REV>]\n          Only tags whose peeled commit contains this revision (`HEAD` when omitted)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --points-at <REV>\n          Only tags pointing at this object (repeatable)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n  -d, --delete\n          Delete the named tag instead of creating it\n\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n  -a, --annotate\n          Git habit: `-m` / `-F` already write an annotated tag; ignored when a message is set\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -f, --force\n          Replace an existing tag with the same name\n\n      --dry-run\n          Preview create or delete without changing refs\n\n  -s, --sign\n          Sign the tag object (implies annotated). Honors `tag.gpgSign` when omitted\n\n      --no-sign\n          Do not sign even when `tag.gpgSign` is true\n\n      --signing-key <KEY>\n          Signing key id or path (overrides `user.signingkey` for this tag)\n\n  -v, --verify\n          Verify annotated tag signatures and optional `tree-sha256` claims\n\n      --no-signature\n          Skip signature verification (still checks `tree-sha256` when present)\n\n      --tree-sha256\n          Attach a tree-sha256 content digest to the tag (implies `--sign`)\n\n      --exclude-submodule <GLOB>\n          Submodule path globs excluded from the digest (repeatable)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "update": "Update grit to the latest release (re-runs the install script)\n\nUsage: grit update [OPTIONS]\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "upload-pack": "Serve a fetch or clone over stdin/stdout (run by ssh and grit-http-server)\n\nUsage: grit upload-pack [OPTIONS] <DIRECTORY>\n\nArguments:\n  <DIRECTORY>\n          The repository to serve\n\nOptions:\n      --stateless-rpc\n          Answer a single request without advertising refs first (smart HTTP)\n\n      --advertise-refs\n          Print the ref advertisement and exit (smart HTTP discovery)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree": "List, add, or remove linked worktrees\n\nUsage: grit worktree [OPTIONS] <COMMAND>\n\nCommands:\n  list    List registered worktrees (main first, then linked)\n  add     Create a linked worktree at `path`\n  remove  Remove a linked worktree\n  prune   Drop registrations for linked worktrees whose directories are gone\n  lock    Mark a linked worktree as locked (prevents accidental removal)\n  unlock  Clear the lock on a linked worktree\n  move    Move a linked worktree to a new directory\n  repair  Fix `.git` / `gitdir` links after a manual directory move\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree add": "Create a linked worktree at `path`\n\nUsage: grit worktree add [OPTIONS] <PATH> [REV]\n\nArguments:\n  <PATH>\n          Directory for the new working tree\n\n  [REV]\n          Commit or branch to check out (defaults to `HEAD`)\n\nOptions:\n  -b, --branch <NAME>\n          Create and check out a new branch\n\n  -B <NAME>\n          Create or reset a branch to the start point (`-B`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --detach\n          Check out in detached HEAD mode\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -f, --force\n          Reuse a stale registration when the working tree directory is missing\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --lock\n          Mark the new worktree locked before checkout finishes\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --reason <REASON>\n          Reason stored in the lock file (requires `--lock`)\n\n      --no-checkout\n          Register the worktree without populating files (HEAD only)\n\n      --track\n          Set upstream when the start point is a remote-tracking branch\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit worktree help [COMMAND]\n\nCommands:\n  list    List registered worktrees (main first, then linked)\n  add     Create a linked worktree at `path`\n  remove  Remove a linked worktree\n  prune   Drop registrations for linked worktrees whose directories are gone\n  lock    Mark a linked worktree as locked (prevents accidental removal)\n  unlock  Clear the lock on a linked worktree\n  move    Move a linked worktree to a new directory\n  repair  Fix `.git` / `gitdir` links after a manual directory move\n  help    Print this message or the help of the given subcommand(s)\n",
  "worktree help add": "Create a linked worktree at `path`\n\nUsage: grit worktree help add\n",
  "worktree help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit worktree help help\n",
  "worktree help list": "List registered worktrees (main first, then linked)\n\nUsage: grit worktree help list\n",
  "worktree help lock": "Mark a linked worktree as locked (prevents accidental removal)\n\nUsage: grit worktree help lock\n",
  "worktree help move": "Move a linked worktree to a new directory\n\nUsage: grit worktree help move\n",
  "worktree help prune": "Drop registrations for linked worktrees whose directories are gone\n\nUsage: grit worktree help prune\n",
  "worktree help remove": "Remove a linked worktree\n\nUsage: grit worktree help remove\n",
  "worktree help repair": "Fix `.git` / `gitdir` links after a manual directory move\n\nUsage: grit worktree help repair\n",
  "worktree help unlock": "Clear the lock on a linked worktree\n\nUsage: grit worktree help unlock\n",
  "worktree list": "List registered worktrees (main first, then linked)\n\nUsage: grit worktree list [OPTIONS]\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree lock": "Mark a linked worktree as locked (prevents accidental removal)\n\nUsage: grit worktree lock [OPTIONS] <PATH>\n\nArguments:\n  <PATH>\n          Path to the linked worktree\n\nOptions:\n      --reason <REASON>\n          Optional reason stored in the lock file\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree move": "Move a linked worktree to a new directory\n\nUsage: grit worktree move [OPTIONS] <WORKTREE> <NEW_PATH>\n\nArguments:\n  <WORKTREE>\n          Current worktree path\n\n  <NEW_PATH>\n          New path for the working tree\n\nOptions:\n  -f, --force\n          Allow move when the worktree is locked\n\n      --dry-run\n          Preview the move without changing disk state\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree prune": "Drop registrations for linked worktrees whose directories are gone\n\nUsage: grit worktree prune [OPTIONS]\n\nOptions:\n      --dry-run\n          List prunable worktrees without removing registrations\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree remove": "Remove a linked worktree\n\nUsage: grit worktree remove [OPTIONS] <PATH>\n\nArguments:\n  <PATH>\n          Path to the worktree to remove\n\nOptions:\n  -f, --force\n          Remove even when the worktree has local changes or is locked\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree repair": "Fix `.git` / `gitdir` links after a manual directory move\n\nUsage: grit worktree repair [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Linked worktree roots to repair (default: all registered linked worktrees)\n\nOptions:\n      --dry-run\n          Report repairs without writing files\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "worktree unlock": "Clear the lock on a linked worktree\n\nUsage: grit worktree unlock [OPTIONS] <PATH>\n\nArguments:\n  <PATH>\n          Path to the linked worktree\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n"
}
