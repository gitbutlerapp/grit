{
  "$id": "https://grit-scm.com/schemas/worktree.remove/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "PrunedWorktreeRow": {
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "type": "object"
    },
    "WorktreeRow": {
      "properties": {
        "bare": {
          "type": "boolean"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "detached": {
          "type": "boolean"
        },
        "head": {
          "type": "string"
        },
        "lock_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "prunable": {
          "type": "boolean"
        }
      },
      "required": [
        "bare",
        "detached",
        "head",
        "locked",
        "path",
        "prunable"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit worktree`, tagged by `action`.",
  "oneOf": [
    {
      "properties": {
        "action": {
          "enum": [
            "list"
          ],
          "type": "string"
        },
        "worktrees": {
          "items": {
            "$ref": "#/definitions/WorktreeRow"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "worktrees"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "add"
          ],
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_out": {
          "type": "boolean"
        },
        "head": {
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "checked_out",
        "head",
        "locked",
        "path"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "remove"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "path"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "prune"
          ],
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "pruned": {
          "items": {
            "$ref": "#/definitions/PrunedWorktreeRow"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "dry_run",
        "pruned"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "lock"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "path"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "unlock"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "path"
      ],
      "type": "object"
    }
  ],
  "title": "WorktreeOutcome"
}
