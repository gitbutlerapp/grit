{
  "$id": "https://grit-scm.com/schemas/add/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit add`: paths staged or that would be staged.",
  "properties": {
    "added": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "count": {
      "description": "Total paths touched (same as `staged`; kept for one release).",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "dry_run": {
      "type": "boolean"
    },
    "modified": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "removed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "staged": {
      "description": "How many paths were staged (alias of `count` for scripts written before path lists).",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "added",
    "count",
    "dry_run",
    "modified",
    "removed",
    "staged"
  ],
  "title": "AddOutcome",
  "type": "object"
}
