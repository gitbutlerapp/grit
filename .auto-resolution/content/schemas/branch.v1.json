{
  "$id": "https://grit-scm.com/schemas/branch/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "BranchEntry": {
      "description": "One branch in a `list` outcome.",
      "properties": {
        "current": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "current",
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit branch`, tagged by `action` (`list` / `create` / `delete`).",
  "oneOf": [
    {
      "properties": {
        "action": {
          "enum": [
            "list"
          ],
          "type": "string"
        },
        "branches": {
          "items": {
            "$ref": "#/definitions/BranchEntry"
          },
          "type": "array"
        },
        "current": {
          "description": "The current branch, or `null` when detached / unborn.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "branches"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "create"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "name"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "delete"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "oid": {
          "description": "Full object id of the branch tip before deletion.",
          "type": "string"
        },
        "short_oid": {
          "description": "Abbreviated tip id (seven hex digits when possible).",
          "type": "string"
        }
      },
      "required": [
        "action",
        "name",
        "oid",
        "short_oid"
      ],
      "type": "object"
    }
  ],
  "title": "BranchOutcome"
}
