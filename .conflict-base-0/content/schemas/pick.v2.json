{
  "$id": "https://grit-scm.com/schemas/pick/v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ConflictJson": {
      "description": "One conflicted path in `--json` operation output.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "PickCommitRecord": {
      "description": "One commit recorded in pick `--json` output.",
      "properties": {
        "change_id": {
          "description": "Stored `change-id` on `oid` when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "oid": {
          "description": "New commit on the current branch, or JSON `null` when `--no-commit` or stopped early.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Source commit that was replayed (full hex oid).",
          "type": "string"
        },
        "subject": {
          "description": "Subject line from the source commit (or the new commit when available).",
          "type": "string"
        }
      },
      "required": [
        "source",
        "subject"
      ],
      "type": "object"
    },
    "PickResult": {
      "description": "Integration result for `grit pick` (`--json` contract).",
      "enum": [
        "picked",
        "conflicts",
        "empty",
        "aborted",
        "skipped"
      ],
      "type": "string"
    }
  },
  "description": "Result of `grit pick`.",
  "properties": {
    "alternatives": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "commits": {
      "description": "Commits picked or attempted in this invocation.",
      "items": {
        "$ref": "#/definitions/PickCommitRecord"
      },
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/definitions/ConflictJson"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "dropped": {
      "description": "Source commits skipped as empty/redundant (`--empty drop` or already applied).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "next_steps": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "result": {
      "$ref": "#/definitions/PickResult"
    }
  },
  "required": [
    "commits",
    "dropped",
    "result"
  ],
  "title": "PickOutcome",
  "type": "object"
}
