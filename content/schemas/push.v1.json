{
  "$id": "https://grit-scm.com/schemas/push/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "PushRefOutcomeStatus": {
      "description": "Per-ref push status in JSON (`ok`, `up_to_date`, or `rejected`).",
      "enum": [
        "ok",
        "up_to_date",
        "rejected"
      ],
      "type": "string"
    },
    "PushRefResult": {
      "description": "One ref's push result.",
      "properties": {
        "reason": {
          "description": "Rejection detail, present only when `status == \"rejected\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/PushRefOutcomeStatus"
        }
      },
      "required": [
        "ref",
        "status"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit push`: the per-ref outcomes for the remote.",
  "properties": {
    "branch": {
      "description": "Local branch (short name) that was pushed, when there is a single unambiguous branch. Omitted for `--tags`, multi-ref `--delete`, and similar pushes that do not map to one branch name.",
      "type": [
        "string",
        "null"
      ]
    },
    "rejected": {
      "description": "True when any ref was rejected (dispatch exits non-zero on this).",
      "type": "boolean"
    },
    "remote": {
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/definitions/PushRefResult"
      },
      "type": "array"
    }
  },
  "required": [
    "rejected",
    "remote",
    "results"
  ],
  "title": "PushOutcome",
  "type": "object"
}
