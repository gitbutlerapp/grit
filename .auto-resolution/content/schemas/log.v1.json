{
  "$id": "https://grit-scm.com/schemas/log/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ChangeStatus": {
      "description": "Machine-readable diff change status (`--json` / `--markdown` contract).",
      "enum": [
        "added",
        "deleted",
        "modified",
        "type_changed",
        "renamed",
        "copied",
        "unmerged"
      ],
      "type": "string"
    },
    "DiffStat": {
      "description": "A diffstat: per-file insertion/deletion counts plus totals.",
      "properties": {
        "deletions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/definitions/FileStat"
          },
          "type": "array"
        },
        "files_changed": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deletions",
        "files",
        "files_changed",
        "insertions"
      ],
      "type": "object"
    },
    "DiffTotalsJson": {
      "description": "Aggregate line counts for `--stat` / `--numstat` JSON.",
      "properties": {
        "deletions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "files_changed": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deletions",
        "files_changed",
        "insertions"
      ],
      "type": "object"
    },
    "FileDiff": {
      "description": "One changed file.",
      "properties": {
        "binary": {
          "type": "boolean"
        },
        "hunks": {
          "description": "Patch hunks; omitted in JSON unless the output format is a full patch.",
          "items": {
            "$ref": "#/definitions/Hunk"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "new_encoding_lossy": {
          "description": "True when new side bytes were decoded with lossy UTF-8.",
          "type": "boolean"
        },
        "new_mode": {
          "description": "New git mode (octal), when present on this side.",
          "type": [
            "string",
            "null"
          ]
        },
        "old_encoding_lossy": {
          "description": "True when old side bytes were decoded with lossy UTF-8.",
          "type": "boolean"
        },
        "old_mode": {
          "description": "Old git mode (octal), when present on this side.",
          "type": [
            "string",
            "null"
          ]
        },
        "old_path": {
          "description": "Pre-rename path, when different from `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Display path (the new path, or the old path for a deletion).",
          "type": "string"
        },
        "similarity": {
          "description": "Rename/copy similarity (0–100).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stat": {
          "anyOf": [
            {
              "$ref": "#/definitions/LineStatJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "Line counts when `--stat` / `--numstat` / `--shortstat` is active."
        },
        "status": {
          "$ref": "#/definitions/ChangeStatus"
        }
      },
      "required": [
        "binary",
        "path",
        "status"
      ],
      "type": "object"
    },
    "FileStat": {
      "properties": {
        "binary": {
          "type": "boolean"
        },
        "deletions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "old_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "similarity": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/ChangeStatus"
        }
      },
      "required": [
        "binary",
        "deletions",
        "insertions",
        "path",
        "status"
      ],
      "type": "object"
    },
    "Hunk": {
      "description": "A contiguous run of changes plus surrounding context.",
      "properties": {
        "context": {
          "description": "The enclosing definition line (function/struct/…), when found.",
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "items": {
            "$ref": "#/definitions/Line"
          },
          "type": "array"
        },
        "new_lines": {
          "description": "Lines on the new side in this hunk (context + additions).",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "new_start": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "old_lines": {
          "description": "Lines on the old side in this hunk (context + removals).",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "old_start": {
          "description": "1-based first old/new line numbers in the hunk.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "lines",
        "new_lines",
        "new_start",
        "old_lines",
        "old_start"
      ],
      "type": "object"
    },
    "Line": {
      "description": "JSON schema shape for [`Line`] (`text` or `segments`, never both).",
      "properties": {
        "kind": {
          "$ref": "#/definitions/LineKind"
        },
        "new": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "no_newline_at_eof": {
          "type": "boolean"
        },
        "old": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "segments": {
          "items": {
            "$ref": "#/definitions/Segment"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "LineKind": {
      "enum": [
        "context",
        "add",
        "del"
      ],
      "type": "string"
    },
    "LineStatJson": {
      "description": "Per-file line counts in JSON when stat modes are active.",
      "properties": {
        "deletions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deletions",
        "insertions"
      ],
      "type": "object"
    },
    "LogCommit": {
      "description": "One commit in `grit log` JSON output.",
      "properties": {
        "author": {
          "$ref": "#/definitions/Person"
        },
        "files": {
          "description": "Per-file diff detail when `-p`, `--stat`, `--name-only`, or `--name-status` is set.",
          "items": {
            "$ref": "#/definitions/FileDiff"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "oid": {
          "type": "string"
        },
        "relative_date": {
          "description": "Relative author date (e.g. `3 days ago`), when `now` is supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "stat": {
          "anyOf": [
            {
              "$ref": "#/definitions/DiffStat"
            },
            {
              "type": "null"
            }
          ],
          "description": "The files the commit changed, only with `--stat` (same shape as [`grit show`](../show/))."
        },
        "subject": {
          "type": "string"
        },
        "totals": {
          "anyOf": [
            {
              "$ref": "#/definitions/DiffTotalsJson"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "author",
        "oid",
        "subject"
      ],
      "type": "object"
    },
    "Person": {
      "description": "A parsed identity line (`Name <email> <epoch> <tz>`) for stable `--json` output.",
      "properties": {
        "date": {
          "description": "Author or committer timestamp in RFC 3339.",
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "email",
        "name"
      ],
      "type": "object"
    },
    "Segment": {
      "description": "A run of text within a line, flagged if it's part of the word-level change.",
      "properties": {
        "emphasis": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit log`: one page of commits, plus the next page's start (if any).",
  "properties": {
    "commits": {
      "items": {
        "$ref": "#/definitions/LogCommit"
      },
      "type": "array"
    },
    "next": {
      "description": "Opaque continuation cursor for `--before`, or `null` when there is no further history.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "commits"
  ],
  "title": "LogOutcome",
  "type": "object"
}
