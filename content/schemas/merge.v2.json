{
  "$id": "https://grit-scm.com/schemas/merge/v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ConflictJson": {
      "description": "One conflicted path in `--json` operation output.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "MergeResult": {
      "description": "Merge / pull integration result (`--json` contract).",
      "oneOf": [
        {
          "enum": [
            "up_to_date",
            "fast_forward",
            "merged",
            "conflicts",
            "aborted",
            "squashed",
            "stopped",
            "refused_not_ff"
          ],
          "type": "string"
        },
        {
          "description": "Three-way merge would succeed (`grit merge --check` only).",
          "enum": [
            "clean"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Result of `grit merge` (and the merge half of `grit pull`).",
  "properties": {
    "alternatives": {
      "description": "Abort/skip options when `result` is `conflicts` (not part of the ordered sequence).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "branch": {
      "description": "The merge source label.",
      "type": "string"
    },
    "change_id": {
      "description": "Stored `change-id` on the resulting commit when `oid` is set and a header is present.",
      "type": [
        "string",
        "null"
      ]
    },
    "check": {
      "description": "True when this outcome is from `grit merge --check` (nothing was merged).",
      "type": "boolean"
    },
    "conflicts": {
      "description": "Structured conflicts when `result` is `conflicts`.",
      "items": {
        "$ref": "#/definitions/ConflictJson"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "dry_run": {
      "description": "True when this outcome is from `grit merge --dry-run` (nothing was merged).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "next_steps": {
      "description": "Suggested `grit` commands when `result` is `conflicts`.",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "oid": {
      "description": "Resulting commit (fast-forward target or merge commit).",
      "type": [
        "string",
        "null"
      ]
    },
    "parents": {
      "description": "Parent commits of a predicted merge commit (`--dry-run` with `result: merged`).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "result": {
      "$ref": "#/definitions/MergeResult"
    },
    "updated_branch": {
      "description": "Current branch whose tip moved after a fast-forward; omitted when it matches `branch`.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "branch",
    "result"
  ],
  "title": "MergeOutcome",
  "type": "object"
}
