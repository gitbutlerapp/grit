{
  "$id": "https://grit-scm.com/schemas/cat/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "CatContentJson": {
      "description": "Object payload shape in `--json` output.",
      "oneOf": [
        {
          "description": "Blob payload in JSON (`--json` contract).",
          "properties": {
            "data_base64": {
              "type": [
                "string",
                "null"
              ]
            },
            "encoding": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "blob"
              ],
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "encoding",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "entries": {
              "items": {
                "$ref": "#/definitions/TreeLineJson"
              },
              "type": "array"
            },
            "kind": {
              "enum": [
                "tree"
              ],
              "type": "string"
            }
          },
          "required": [
            "entries",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Commit or tag body in JSON (raw object payload bytes).",
          "properties": {
            "data_base64": {
              "type": [
                "string",
                "null"
              ]
            },
            "encoding": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "commit"
              ],
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "encoding",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Commit or tag body in JSON (raw object payload bytes).",
          "properties": {
            "data_base64": {
              "type": [
                "string",
                "null"
              ]
            },
            "encoding": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "tag"
              ],
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "encoding",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "TreeLineJson": {
      "description": "One tree line in JSON (same fields as human `ls-tree` output).",
      "properties": {
        "mode": {
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "oid",
        "path",
        "type"
      ],
      "type": "object"
    },
    "WarningRecord": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit cat`.",
  "properties": {
    "content": {
      "$ref": "#/definitions/CatContentJson"
    },
    "kind": {
      "type": "string"
    },
    "oid": {
      "type": "string"
    },
    "size": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "spec": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/definitions/WarningRecord"
      },
      "type": "array"
    }
  },
  "required": [
    "content",
    "kind",
    "oid",
    "size",
    "spec"
  ],
  "title": "CatOutcome",
  "type": "object"
}
