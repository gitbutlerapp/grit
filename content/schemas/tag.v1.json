{
  "$id": "https://grit-scm.com/schemas/tag/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ExcludedSubmoduleJson": {
      "properties": {
        "oid": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "oid",
        "path"
      ],
      "type": "object"
    },
    "NotVerifiableSubmoduleJson": {
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "type": "object"
    },
    "TagAnnotationEntry": {
      "description": "Annotated tag metadata in list JSON.",
      "properties": {
        "date": {
          "description": "Tagger Unix timestamp.",
          "format": "int64",
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "tagger": {
          "$ref": "#/definitions/TagIdentEntry"
        }
      },
      "required": [
        "date",
        "message",
        "subject",
        "tagger"
      ],
      "type": "object"
    },
    "TagEntry": {
      "description": "One tag in a `list` outcome.",
      "properties": {
        "annotation": {
          "anyOf": [
            {
              "$ref": "#/definitions/TagAnnotationEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/definitions/TagRefKind"
        },
        "name": {
          "type": "string"
        },
        "oid": {
          "description": "Hex object id the tag ref points at.",
          "type": "string"
        },
        "peeled": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_kind": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "oid",
        "target_kind"
      ],
      "type": "object"
    },
    "TagIdentEntry": {
      "description": "Identity fields in JSON tag annotations.",
      "properties": {
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "name"
      ],
      "type": "object"
    },
    "TagRefKind": {
      "description": "Tag ref kind in JSON (`lightweight` or `annotated`).",
      "enum": [
        "lightweight",
        "annotated"
      ],
      "type": "string"
    },
    "TagSignatureJson": {
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "signer": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "description": "`good`, `bad`, `missing`, or `not_checked`.",
          "type": "string"
        }
      },
      "required": [
        "verdict"
      ],
      "type": "object"
    },
    "TagTreeSha256Json": {
      "properties": {
        "bogus_excluded": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claimed": {
          "type": "string"
        },
        "computed": {
          "type": "string"
        },
        "cycles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "excluded": {
          "items": {
            "$ref": "#/definitions/ExcludedSubmoduleJson"
          },
          "type": "array"
        },
        "files": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "match_digest": {
          "type": "boolean"
        },
        "submodules": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "bogus_excluded",
        "claimed",
        "computed",
        "cycles",
        "excluded",
        "files",
        "match_digest",
        "submodules"
      ],
      "type": "object"
    },
    "TagVerifyEntry": {
      "description": "Per-tag result for `grit tag --verify`.",
      "properties": {
        "elapsed": {
          "allOf": [
            {
              "$ref": "#/definitions/TagVerifyTimingJson"
            }
          ],
          "description": "Wall time spent verifying this tag."
        },
        "name": {
          "type": "string"
        },
        "not_verifiable_submodules": {
          "description": "Submodule paths that could not be hashed for digest verification.",
          "items": {
            "$ref": "#/definitions/NotVerifiableSubmoduleJson"
          },
          "type": "array"
        },
        "oid": {
          "description": "Hex object id of the annotated tag object.",
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "signature": {
          "$ref": "#/definitions/TagSignatureJson"
        },
        "target": {
          "description": "Hex object id from the tag's `object` header.",
          "type": "string"
        },
        "tree_sha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/TagTreeSha256Json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "elapsed",
        "name",
        "not_verifiable_submodules",
        "oid",
        "ok",
        "signature",
        "target"
      ],
      "type": "object"
    },
    "TagVerifyTimingJson": {
      "properties": {
        "ms": {
          "description": "Elapsed milliseconds (rounded).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "ms"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit tag`, tagged by `action` (`list` / `create` / `delete`).",
  "oneOf": [
    {
      "description": "Tags matching the list query.",
      "properties": {
        "action": {
          "enum": [
            "list"
          ],
          "type": "string"
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagEntry"
          },
          "type": "array"
        },
        "truncated": {
          "description": "True when more tags matched than returned (`-n` / `--limit`).",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "tags"
      ],
      "type": "object"
    },
    {
      "description": "A new tag was created.",
      "properties": {
        "action": {
          "enum": [
            "create"
          ],
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/TagRefKind"
        },
        "name": {
          "type": "string"
        },
        "oid": {
          "description": "Hex object id the tag ref points at.",
          "type": "string"
        },
        "peeled": {
          "type": [
            "string",
            "null"
          ]
        },
        "replaced": {
          "type": [
            "string",
            "null"
          ]
        },
        "signed": {
          "description": "Whether the tag object carries a cryptographic signature.",
          "type": "boolean"
        },
        "tree_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree_sha256_excluded": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tree_sha256_files": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tree_sha256_hash_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tree_sha256_submodules": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "dry_run",
        "kind",
        "name",
        "oid",
        "signed"
      ],
      "type": "object"
    },
    {
      "description": "A tag was deleted.",
      "properties": {
        "action": {
          "enum": [
            "delete"
          ],
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "dry_run",
        "name"
      ],
      "type": "object"
    },
    {
      "description": "One or more annotated tags were verified.",
      "properties": {
        "action": {
          "enum": [
            "verify"
          ],
          "type": "string"
        },
        "ok": {
          "description": "True when every listed tag passed verification.",
          "type": "boolean"
        },
        "tags": {
          "items": {
            "$ref": "#/definitions/TagVerifyEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "ok",
        "tags"
      ],
      "type": "object"
    }
  ],
  "title": "TagOutcome"
}
