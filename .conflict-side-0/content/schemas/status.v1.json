{
  "$id": "https://grit-scm.com/schemas/status/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ChangeJson": {
      "description": "A single worktree/index change in JSON output.",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ChangeStatus"
        }
      },
      "required": [
        "path",
        "status"
      ],
      "type": "object"
    },
    "ChangeStatus": {
      "description": "Machine-readable diff change status (`--json` / `--markdown` contract).",
      "enum": [
        "added",
        "deleted",
        "modified",
        "type_changed",
        "renamed",
        "copied",
        "unmerged"
      ],
      "type": "string"
    },
    "CommitJson": {
      "description": "A commit in JSON output: full hex `oid`, subject, author, and dates.",
      "properties": {
        "author": {
          "$ref": "#/definitions/Person"
        },
        "oid": {
          "type": "string"
        },
        "relative_date": {
          "description": "Relative author date (e.g. `3 days ago`), when `now` is supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "oid",
        "subject"
      ],
      "type": "object"
    },
    "Person": {
      "description": "A parsed identity line (`Name <email> <epoch> <tz>`) for stable `--json` output.",
      "properties": {
        "date": {
          "description": "Author or committer timestamp in RFC 3339.",
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "email",
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit status`.",
  "properties": {
    "ahead": {
      "description": "Number of commits ahead of `target` (full count).",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "behind": {
      "description": "Number of commits on `target` not in the current branch (full count).",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "branch": {
      "description": "Current branch (short name), or `null` when detached / invalid.",
      "type": [
        "string",
        "null"
      ]
    },
    "clean": {
      "type": "boolean"
    },
    "commits": {
      "description": "Newest ahead-of-target commits (newest first), up to the status shortlog limit.",
      "items": {
        "$ref": "#/definitions/CommitJson"
      },
      "type": "array"
    },
    "conflicts": {
      "description": "Unmerged paths from the index (stages 1–3).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "detached": {
      "type": "boolean"
    },
    "head": {
      "description": "HEAD commit (full oid), or `null` on an unborn / invalid HEAD.",
      "type": [
        "string",
        "null"
      ]
    },
    "in_progress": {
      "description": "In-progress operations (e.g. `merge`, `rebase`), when any apply.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "merging": {
      "description": "True when a merge is in progress (`MERGE_HEAD` exists).",
      "type": "boolean"
    },
    "staged": {
      "items": {
        "$ref": "#/definitions/ChangeJson"
      },
      "type": "array"
    },
    "target": {
      "description": "Target branch name, or `null` when none applies / was found.",
      "type": [
        "string",
        "null"
      ]
    },
    "unstaged": {
      "items": {
        "$ref": "#/definitions/ChangeJson"
      },
      "type": "array"
    },
    "untracked": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "ahead",
    "behind",
    "clean",
    "commits",
    "detached",
    "merging",
    "staged",
    "unstaged",
    "untracked"
  ],
  "title": "StatusOutcome",
  "type": "object"
}
