{
  "$id": "https://grit-scm.com/schemas/revs/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "CommitJson": {
      "description": "Shared commit object in JSON output (`log`, `show`, `revs`, `shortlog`, …).",
      "properties": {
        "author": {
          "$ref": "#/definitions/Person"
        },
        "committer": {
          "$ref": "#/definitions/Person"
        },
        "equivalent": {
          "description": "Patch-id equivalent mark when `grit revs --cherry-mark` is set.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "message": {
          "description": "Full message body with trailing whitespace trimmed.",
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "refs": {
          "description": "Ref decorations (branches, tags, `HEAD`, …) for this commit.",
          "items": {
            "$ref": "#/definitions/CommitRefJson"
          },
          "type": "array"
        },
        "relative_date": {
          "description": "Relative author date (e.g. `3 days ago`), when `now` is supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "description": "Symmetric-range side when `grit revs --left-right` is set.",
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "committer",
        "message",
        "oid",
        "parents",
        "refs",
        "subject"
      ],
      "type": "object"
    },
    "CommitRefJson": {
      "description": "Ref decoration attached to a commit in JSON output.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/CommitRefKind"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "CommitRefKind": {
      "description": "Decoration category in JSON (`--json` contract).",
      "enum": [
        "branch",
        "remote_branch",
        "tag",
        "stash",
        "head",
        "grafted",
        "other"
      ],
      "type": "string"
    },
    "Person": {
      "description": "A parsed identity line (`Name <email> <epoch> <tz>`) for stable `--json` output.",
      "properties": {
        "date": {
          "description": "Author or committer timestamp in RFC 3339.",
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "email",
        "name"
      ],
      "type": "object"
    },
    "RevsLeftRightCount": {
      "description": "Left/right counts for a symmetric range (`--left-right --count`).",
      "properties": {
        "equivalent": {
          "description": "Present for `--cherry-mark --left-right --count` (Git's third column).",
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "left": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "right": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit revs`.",
  "properties": {
    "commits": {
      "description": "Listed commits in `rev-list` order (empty when `--count` is set).",
      "items": {
        "$ref": "#/definitions/CommitJson"
      },
      "type": "array"
    },
    "count": {
      "description": "Total reachable commits when `--count` is set without `--left-right`; otherwise `null`.",
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "left_right": {
      "anyOf": [
        {
          "$ref": "#/definitions/RevsLeftRightCount"
        },
        {
          "type": "null"
        }
      ],
      "description": "Left/right counts when `--count` and `--left-right` are set; otherwise `null`."
    },
    "next": {
      "description": "Continuation cursor when the list is resumable; always `null` for `revs` today.",
      "type": [
        "string",
        "null"
      ]
    },
    "truncated": {
      "description": "True when more commits matched than returned (`-n`).",
      "type": "boolean"
    }
  },
  "required": [
    "commits",
    "truncated"
  ],
  "title": "RevsOutcome",
  "type": "object"
}
