{
  "$id": "https://grit-scm.com/schemas/patch-id/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "PatchIdLine": {
      "description": "One `(patch_id, commit)` pair (Git `patch-id` stdout format).",
      "properties": {
        "commit": {
          "type": "string"
        },
        "patch_id": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "patch_id"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit patch-id`.",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/definitions/PatchIdLine"
      },
      "type": "array"
    }
  },
  "required": [
    "entries"
  ],
  "title": "PatchIdOutcome",
  "type": "object"
}
