{
  "$id": "https://grit-scm.com/schemas/status/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ChangeJson": {
      "description": "A single worktree/index change in JSON output.",
      "properties": {
        "old_path": {
          "description": "Previous path for renames and copies (`null` when not applicable).",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ChangeStatus"
        }
      },
      "required": [
        "path",
        "status"
      ],
      "type": "object"
    },
    "ChangeStatus": {
      "description": "Machine-readable diff change status (`--json` / `--markdown` contract).",
      "enum": [
        "added",
        "deleted",
        "modified",
        "type_changed",
        "renamed",
        "copied",
        "unmerged"
      ],
      "type": "string"
    },
    "CommitJson": {
      "description": "Shared commit object in JSON output (`log`, `show`, `revs`, `shortlog`, …).",
      "properties": {
        "author": {
          "$ref": "#/definitions/Person"
        },
        "change_id": {
          "description": "Stable change id (reverse-hex; stored header or derived from commit id).",
          "type": "string"
        },
        "change_id_stored": {
          "description": "`true` when `change_id` came from a `change-id` commit header.",
          "type": "boolean"
        },
        "committer": {
          "$ref": "#/definitions/Person"
        },
        "message": {
          "description": "Full message body with trailing whitespace trimmed.",
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "refs": {
          "description": "Ref decorations (branches, tags, `HEAD`, …) for this commit.",
          "items": {
            "$ref": "#/definitions/CommitRefJson"
          },
          "type": "array"
        },
        "relative_date": {
          "description": "Relative author date (e.g. `3 days ago`), when `now` is supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "change_id",
        "change_id_stored",
        "committer",
        "message",
        "oid",
        "parents",
        "refs",
        "subject"
      ],
      "type": "object"
    },
    "CommitRefJson": {
      "description": "Ref decoration attached to a commit in JSON output.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/CommitRefKind"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "CommitRefKind": {
      "description": "Decoration category in JSON (`--json` contract).",
      "enum": [
        "branch",
        "remote_branch",
        "tag",
        "stash",
        "head",
        "grafted",
        "other"
      ],
      "type": "string"
    },
    "ConflictJson": {
      "description": "One unmerged path in `--json` output.",
      "properties": {
        "kind": {
          "description": "Conflict category (`both_modified`, `both_added`, …).",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "OperationJson": {
      "description": "Paused operation and suggested `grit` commands.",
      "properties": {
        "alternatives": {
          "description": "Mutually exclusive options (for example cancel the merge).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "description": "Stable operation id (for example `merge`).",
          "type": "string"
        },
        "next_steps": {
          "description": "Suggested follow-up commands, in order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "next_steps"
      ],
      "type": "object"
    },
    "Person": {
      "description": "A parsed identity line (`Name <email> <epoch> <tz>`) for stable `--json` output.",
      "properties": {
        "date": {
          "description": "Author or committer timestamp in RFC 3339.",
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "email",
        "name"
      ],
      "type": "object"
    },
    "StatusUpstreamJson": {
      "description": "Upstream ahead/behind in `--json` / `--markdown` output.",
      "properties": {
        "ahead": {
          "description": "Commits on this branch not on the upstream, or `null` when counts were skipped.",
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "behind": {
          "description": "Commits on the upstream not on this branch, or `null` when counts were skipped.",
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ref": {
          "description": "Short upstream ref name (`origin/topic`).",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit status`.",
  "properties": {
    "ahead": {
      "description": "Number of commits ahead of `target` (full count), or `null` when counts were skipped.",
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "behind": {
      "description": "Number of commits on `target` not in the current branch (full count), or `null` when skipped.",
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "branch": {
      "description": "Current branch (short name), or `null` when detached / invalid.",
      "type": [
        "string",
        "null"
      ]
    },
    "clean": {
      "type": "boolean"
    },
    "commits": {
      "description": "Newest ahead-of-target commits (newest first), up to the status shortlog limit.",
      "items": {
        "$ref": "#/definitions/CommitJson"
      },
      "type": "array"
    },
    "conflicts": {
      "description": "Unmerged paths with conflict kind.",
      "items": {
        "$ref": "#/definitions/ConflictJson"
      },
      "type": "array"
    },
    "detached": {
      "type": "boolean"
    },
    "head": {
      "description": "HEAD commit (full oid), or `null` on an unborn / invalid HEAD.",
      "type": [
        "string",
        "null"
      ]
    },
    "ignored": {
      "description": "Ignored paths (only when `--ignored` is passed).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "in_progress": {
      "description": "In-progress operations (e.g. `merge`, `rebase`), when any apply. Deprecated: prefer `operation`.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "merging": {
      "description": "True when a merge is in progress (`MERGE_HEAD` exists). Deprecated: prefer `operation`.",
      "type": "boolean"
    },
    "operation": {
      "anyOf": [
        {
          "$ref": "#/definitions/OperationJson"
        },
        {
          "type": "null"
        }
      ],
      "description": "Primary paused operation and suggested next commands."
    },
    "staged": {
      "items": {
        "$ref": "#/definitions/ChangeJson"
      },
      "type": "array"
    },
    "stash_count": {
      "description": "Number of entries on the stash reflog.",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "target": {
      "description": "Target branch name, or `null` when none applies / was found.",
      "type": [
        "string",
        "null"
      ]
    },
    "unstaged": {
      "items": {
        "$ref": "#/definitions/ChangeJson"
      },
      "type": "array"
    },
    "untracked": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "upstream": {
      "anyOf": [
        {
          "$ref": "#/definitions/StatusUpstreamJson"
        },
        {
          "type": "null"
        }
      ],
      "description": "Upstream tracking comparison when it differs from `target`, or `null`."
    }
  },
  "required": [
    "clean",
    "commits",
    "detached",
    "merging",
    "staged",
    "stash_count",
    "unstaged",
    "untracked"
  ],
  "title": "StatusOutcome",
  "type": "object"
}
