---
source: grit-cli/src/help_output_snapshots.rs
expression: helps
---
{
  "add": "Stage changes. With no paths, stages everything\n\nUsage: grit add [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Files or directories to limit the command to\n\nOptions:\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -u, --update\n          Stage tracked changes only (modified and deleted paths; no untracked files)\n\n      --dry-run\n          Report paths that would be staged without writing the index or object database\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n  -N, --intent-to-add\n          Record intent to add (empty index entries) instead of staging file content\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -f, --force\n          Stage paths that would otherwise be rejected as ignored\n\n      --executable\n          Mark staged regular files as executable (`100755`) in the index\n\n      --non-executable\n          Mark staged regular files as non-executable (`100644`) in the index\n\n      --patch-file <FILE|->\n          Apply a unified diff to the index (`git apply --cached`). Use `-` for stdin\n\n      --hunks <ID,...>\n          Stage only the listed hunk ids from `grit diff --json` (comma-separated, repeatable)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --lines <PATH:START-END>\n          Stage only new-side line ranges from `grit diff --json` (`path:start-end`, repeatable)\n\n  -U, --unified <N>\n          Unified context lines when resolving `--hunks` / `--lines` (match `grit diff -U`; default 3)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "auth": "Sign in to GitButler Code (GitHub inside a github.com repository), a `grit serve` host, or store a username and token for any HTTPS host\n\nUsage: grit auth [OPTIONS] [URL]\n       grit auth <COMMAND>\n\nCommands:\n  logout  Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n  help    Print this message or the help of the given subcommand(s)\n\nArguments:\n  [URL]\n          The host (or one of its repository URLs) to sign in to; without it, code.gitbutler.com, or GitHub when `origin` is on github.com\n\nOptions:\n      --token <TOKEN>\n          Store this access token: with `--username`, for any HTTP(S) host; alone, a `grit serve` or GitButler Code token, checked with the server\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --username <USER>\n          Store `--token` for this user name on any HTTP(S) host, without signing in\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "auth help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit auth help [COMMAND]\n\nCommands:\n  logout  Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n  help    Print this message or the help of the given subcommand(s)\n",
  "auth help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit auth help help\n",
  "auth help logout": "Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n\nUsage: grit auth help logout\n",
  "auth logout": "Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n\nUsage: grit auth logout [OPTIONS] [URL]\n\nArguments:\n  [URL]\n          A host to sign out of instead of the default one\n\nOptions:\n      --dry-run\n          Report which stored credential would be removed without erasing it\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "blame": "Show who last modified each line of a file\n\nUsage: grit blame [OPTIONS] [REV] [-- <FILE>]\n\nArguments:\n  [REV]\n          Optional revision before the file (use `--` to disambiguate paths that look like refs)\n\n  [FILE]\n          File to blame (repository-relative)\n\nOptions:\n      --rev <REV>\n          Blame the file as committed at this revision. Without a revision the working tree file is blamed, with uncommitted lines marked\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -L, --lines <RANGE>\n          Limit output with a Git-style line range (`-L` / `--lines`)\n\n      --first-parent\n          At merge commits, follow only the first parent (Git's `--first-parent`)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --ignore-rev <REV>\n          Ignore this revision when attributing lines (repeatable)\n\n      --ignore-revs-file <FILE>\n          Read revision oids to ignore from a file (repeatable; `\"\"` clears prior entries)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --group\n          With `--json`, emit grouped `hunks[]` instead of per-line `lines[]`\n\n  -w, --ignore-all-space\n          Ignore whitespace when comparing lines (`git blame -w`)\n\n  -C, --copy-detection...\n          Detect lines copied from other files (`git blame -C`; repeat up to three times)\n\n  -M, --move-detection\n          Detect lines moved within the same file (`git blame -M`). Enabled automatically when `-C` is used; Git treats copy detection as implying move detection\n\n      --contents <FILE>\n          Blame this file's content (`-` for stdin) instead of the working tree, on top of the revision (default `HEAD`); lines not in the revision show as uncommitted\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "branch": "List branches, or create / delete / rename / configure one\n\nUsage: grit branch [OPTIONS] [NAME] [START]\n\nArguments:\n  [NAME]\n          Branch to create, delete, rename, or configure upstream for. Omit to list\n\n  [START]\n          Start commit when creating (`grit branch <name> <start>`)\n\nOptions:\n  -f, --force\n          Overwrite an existing branch when creating or renaming\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -t, --track\n          Configure upstream from the start point when creating\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --no-track\n          Do not configure upstream when creating\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n  -u, --set-upstream-to <UPSTREAM>\n          Set upstream for the named branch (or the current branch when omitted)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --unset-upstream\n          Remove upstream configuration for the named branch (or the current branch)\n\n  -m, --move <NAME>...\n          Rename a branch: `-m <new>` or `-m <old> <new>`\n\n  -M <NAME>...\n          Force rename: `-M <new>` or `-M <old> <new>`\n\n  -d, --delete\n          Delete the named branch instead of creating it\n\n  -D, --force-delete\n          Delete even when the branch is not fully merged into the current branch\n\n      --list <GLOB>\n          Include only branches whose short name matches `GLOB` (repeatable)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -r, --remotes\n          List remote-tracking branches under `refs/remotes/`\n\n  -a, --all\n          List local and remote-tracking branches\n\n      --merged [<REV>]\n          List branches merged into `REV` (defaults to `HEAD` when omitted)\n\n      --no-merged [<REV>]\n          List branches not merged into `REV` (defaults to `HEAD` when omitted)\n\n      --contains [<REV>]\n          List branches whose tip contains `REV` (defaults to `HEAD` when omitted)\n\n      --sort <KEY>\n          Sort key: `name`, `version`, or `date`\n\n      --reverse\n          Reverse sort order\n\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --show-current\n          Print the current branch name only (same as `git branch --show-current`)\n\n      --dry-run\n          Preview the operation without updating refs, config, or reflogs\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "bundle": "Create, verify, or list git bundle files\n\nUsage: grit bundle [OPTIONS] <COMMAND>\n\nCommands:\n  create    Write a bundle file from revision specs\n  verify    Check that a bundle file is well-formed\n  list      List refs recorded in a bundle header\n  unbundle  Ingest a bundle pack into the current repository\n  help      Print this message or the help of the given subcommand(s)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "bundle create": "Write a bundle file from revision specs\n\nUsage: grit bundle create [OPTIONS] <FILE> [REV]...\n\nArguments:\n  <FILE>\n          Output bundle path\n\n  [REV]...\n          Commits or ref ranges to include (same rules as `grit log`)\n\nOptions:\n      --all\n          Include every ref tip in the bundle header (`HEAD`, all branches and tags)\n\n      --dry-run\n          Report refs, prerequisites, and object count without writing a file\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "bundle help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit bundle help [COMMAND]\n\nCommands:\n  create    Write a bundle file from revision specs\n  verify    Check that a bundle file is well-formed\n  list      List refs recorded in a bundle header\n  unbundle  Ingest a bundle pack into the current repository\n  help      Print this message or the help of the given subcommand(s)\n",
  "bundle help create": "Write a bundle file from revision specs\n\nUsage: grit bundle help create\n",
  "bundle help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit bundle help help\n",
  "bundle help list": "List refs recorded in a bundle header\n\nUsage: grit bundle help list\n",
  "bundle help unbundle": "Ingest a bundle pack into the current repository\n\nUsage: grit bundle help unbundle\n",
  "bundle help verify": "Check that a bundle file is well-formed\n\nUsage: grit bundle help verify\n",
  "bundle list": "List refs recorded in a bundle header\n\nUsage: grit bundle list [OPTIONS] <FILE>\n\nArguments:\n  <FILE>\n          Bundle file to read\n\nOptions:\n  -n, --limit <N>\n          Maximum number of rows to list\n          \n          [alias: --max-count]\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "bundle unbundle": "Ingest a bundle pack into the current repository\n\nUsage: grit bundle unbundle [OPTIONS] <FILE>\n\nArguments:\n  <FILE>\n          Bundle file to read\n\nOptions:\n      --dry-run\n          Verify and list ref updates without ingesting objects or writing refs\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "bundle verify": "Check that a bundle file is well-formed\n\nUsage: grit bundle verify [OPTIONS] <FILE>\n\nArguments:\n  <FILE>\n          Bundle file to verify\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "cat": "Show blob, tree, commit, or tag contents for a revision spec\n\nUsage: grit cat [OPTIONS] <SPEC>\n\nArguments:\n  <SPEC>\n          Object or revision spec (`HEAD`, `main:path`, `v1^{commit}`, …)\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "checkin": "Send a snapshot checkout's branches back to the server, grafted onto its real history\n\nUsage: grit checkin [OPTIONS] [BRANCH]...\n\nArguments:\n  [BRANCH]...\n          Branches to check in (default: every branch with commits on top of the snapshot)\n\nOptions:\n  -f, --force\n          Replace a server branch even where that drops commits it has\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "checkout": "Start work on a repository from a snapshot of its main branch (or some of its paths) instead of a clone\n\nUsage: grit checkout [OPTIONS] <URL> [SLICE]\n\nArguments:\n  <URL>\n          The repository on a server that offers snapshot checkouts (`grit serve`)\n\n  [SLICE]\n          A slice (named set of paths) on the server to check out; `--path` adds to it\n\nOptions:\n  -p, --path <PATH>\n          Check out only this path, plus the files in the directories above it (repeatable)\n\n      --into <DIR>\n          Directory to check out into (defaults to the repository name)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "clean": "Remove untracked files from the working tree\n\nUsage: grit clean [OPTIONS] [PATH]...\n\nArguments:\n  [PATH]...\n          Files or directories to limit the command to\n\nOptions:\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n  -f, --force\n          Actually delete files. Without this flag, only prints what would be removed\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --dry-run\n          Explicit dry run (default when `-f` is not passed)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --ignored\n          Remove ignored files as well (like `git clean -x`)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --only-ignored\n          Remove only ignored files (like `git clean -X`)\n\n  -e, --exclude <PATTERN>\n          Additional exclude patterns; matching paths are not removed\n\n      --files-only\n          Remove only files, not untracked directories\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "clone": "Copy a remote repository into a new directory.\n\nSubmodule gitlinks are checked out as empty directories only; grit does not fetch submodule repositories or provide a `submodule` command.\n\nUsage: grit clone [OPTIONS] <URL> [DIR]\n\nArguments:\n  <URL>\n          The repository to clone (URL or local path)\n\n  [DIR]\n          Directory to clone into (defaults to the repository name)\n\nOptions:\n      --depth <N>\n          Truncate fetched history to this many commits (`git clone --depth`)\n\n  -b, --branch <NAME>\n          Branch or tag to check out instead of the remote default\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --single-branch\n          Fetch only the branch checked out (same as `git clone --single-branch`)\n\n      --no-single-branch\n          Fetch all branch tips even when `--shallow` is set (`git clone --no-single-branch`)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-tags\n          Do not fetch any tags from the remote\n\n  -o, --origin <NAME>\n          Name for the remote (default `origin`)\n\n      --blobs <none|auto|SIZE>\n          Partial clone: omit blobs (`none`), blobs at/above a size (`1k`, `512`, …), or what the server's accepted promisor remotes hold (`auto`)\n\n      --config <KEY=VALUE>\n          Set a config value in the new repository before fetching (`git clone -c`; repeatable). Unlike the global `-c`, it is kept in the clone's config\n\n      --bare\n          Create a bare repository (`git clone --bare`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --no-checkout\n          Do not check out the default branch (`git clone --no-checkout`)\n\n  -q, --quiet\n          Suppress progress and human output\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "commit": "Stage every change and record a new commit\n\nUsage: grit commit [OPTIONS] [MESSAGE] [-- <PATH>...]\n\nArguments:\n  [MESSAGE]\n          Commit message (you can also pass it with -m)\n\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n  -m, --message <MESSAGE>\n          Commit message text\n\n  -F, --message-file <PATH|->\n          Read the message from a file (`-` for stdin)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -q, --quiet\n          Suppress progress and human output\n\n      --author <AUTHOR>\n          Author ident (`Name <email>` or bare email)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --date <AUTHOR_DATE>\n          Override the author date (Git date formats, RFC 3339, `@epoch`, …)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --trailer <KEY=VALUE>\n          Append a commit trailer (`key=value` or `key: value`); repeat for multiple trailers\n\n  -s, --signoff\n          Append a `Signed-off-by` trailer for the committer\n\n      --reset-author\n          Set the author to the committer with a fresh author date\n\n  -C, --reuse-message <COMMIT>\n          Reuse the log message and author from a commit (`-C` / `--reuse-message`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -S, --gpg-sign\n          Sign the commit with the configured signing key\n\n      --no-gpg-sign\n          Do not sign this commit, even when `commit.gpgsign` is enabled\n\n      --no-verify\n          Skip the `pre-commit` and `commit-msg` hooks\n\n  -a, --all\n          Stage every change first, then commit. This is the default when `commit.autoStage` is true\n\n      --staged\n          Commit only what is already staged (same as `git commit` without `-a`)\n\n      --amend\n          Replace the tip commit instead of creating a new one\n\n      --allow-empty\n          Record a commit even when the tree matches the parent (same as `git commit --allow-empty`)\n\n      --dry-run\n          Compute the commit without writing objects, updating refs, or running hooks\n\n      --patch-file <FILE|->\n          Apply a unified diff to the index, then commit only that staged content (`git apply --cached` + commit)\n\n      --hunks <ID,...>\n          Commit only the listed hunk ids from `grit diff --json` (comma-separated, repeatable)\n\n      --lines <PATH:START-END>\n          Commit only line ranges from the unstaged diff (same format as `grit add --lines`)\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "completions": "Generate shell completion scripts for bash, zsh, or fish\n\nUsage: grit completions [OPTIONS] <SHELL>\n\nArguments:\n  <SHELL>\n          Target shell\n          \n          [possible values: bash, elvish, fish, powershell, zsh]\n\nOptions:\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "config": "Read, set, or list configuration values\n\nUsage: grit config [OPTIONS] [KEY] [VALUE]\n\nArguments:\n  [KEY]\n          The configuration key, e.g. user.name. Optional prefix with `--list`\n\n  [VALUE]\n          The value to set. Omit to read the current value\n\nOptions:\n      --global\n          Use the global (per-user) config file instead of this repository's\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --local\n          Read or write only this repository's config file (`.git/config`)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --system\n          Read or write the system config file (`/etc/gitconfig` or `GIT_CONFIG_SYSTEM`)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --worktree\n          Read or write this worktree's `config.worktree` (requires `extensions.worktreeConfig`)\n\n  -f, --file <PATH>\n          Read or write only the given config file (no repository required)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -l, --list\n          List configuration values (optional `<prefix>` filters keys)\n\n      --all\n          Return every value for a multi-valued key\n\n      --add\n          Append a value without replacing existing entries\n\n      --unset\n          Remove the key instead of reading or setting it\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --unset-all\n          Remove every occurrence of a multi-valued key\n\n      --rename-section <OLD>\n          Current section name for `--rename-section`\n\n      --rename-section-new <NEW>\n          New section name for `--rename-section`\n\n      --remove-section <SECTION>\n          Remove an entire section\n\n      --type <TYPE>\n          Coerce values as bool, int, or path (canonical on write)\n          \n          [possible values: bool, int, path]\n\n      --default <VALUE>\n          When reading, use this value if the key is unset\n\n      --dry-run\n          Show what would change without writing the config file\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "describe": "Nearest reachable tag, exact commit distance, and abbreviated id for a revision\n\nUsage: grit describe [OPTIONS] [REV]\n\nArguments:\n  [REV]\n          Commit or ref to describe (defaults to `HEAD`)\n          \n          [default: HEAD]\n\nOptions:\n      --tags\n          Include lightweight tags (default: annotated tags only)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --match <GLOB>\n          Only consider tags matching this glob (short name)\n\n      --first-parent\n          Follow first-parent chains when counting distance after the tag\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --abbrev <N>\n          Minimum abbreviated commit id length (default follows `core.abbrev`)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "diff": "Show changes as a diff. No argument: uncommitted changes; with a commit: the change that commit introduced; with two commits (or `A..B`) diff their trees\n\nUsage: grit diff [OPTIONS] [COMMIT]... [-- <PATH>...]\n\nArguments:\n  [COMMIT]...\n          One commit (that commit's patch), two commits (tree diff), or a range `A..B` / `A...B`\n\n  [PATH]...\n          Limit the command to these paths (after `--`)\n\nOptions:\n      --no-index\n          Compare two filesystem paths outside any repository (like `git diff --no-index`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n  -S, --staged\n          Staged changes only (index vs HEAD)\n          \n          [alias: --cached]\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --unstaged\n          Unstaged changes only (worktree vs index)\n\n      --against <REF>\n          Compare the worktree to this ref's tree instead of HEAD (no commit arguments)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --exit-code\n          Exit with 1 when there are changes (errors exit 2)\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --quiet\n          Print nothing; implies `--exit-code`\n\n      --pathspec-from-file <FILE|->\n          Read pathspecs from a file (`-` for stdin) instead of or in addition to argv paths\n\n      --pathspec-file-nul\n          `--pathspec-from-file` entries are NUL-separated\n\n  -p, --patch\n          Unified patch for each commit (`git log -p`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --stat\n          Summary with change bars per file (like `git diff --stat`)\n\n      --numstat\n          Machine-readable `insertions<TAB>deletions<TAB>path` lines\n\n      --shortstat\n          Only the summary line (`N files changed, …`)\n\n      --name-only\n          Paths only, one per line\n\n      --name-status\n          Status letter and path(s) per line\n\n      --patch-text\n          Git-apply-compatible unified patch (`git diff --binary` shape); not combinable with `--json`\n\n  -U, --unified <N>\n          Lines of context around each change (Git `-U`)\n\n  -W, --function-context\n          Expand hunks to enclosing function boundaries (Git `-W` / `--function-context`)\n\n  -M, --find-renames[=<N>]\n          Detect renames; optional similarity threshold (`50` default, or `50%`). Use `-M`, `-M30`, or `--find-renames` / `--find-renames=30` (long form requires `=` when a threshold is given)\n\n      --no-renames\n          Do not detect renames\n\n      --diff-algorithm <ALGO>\n          Line diff algorithm (overrides `diff.algorithm`)\n\n      --diff-filter <LETTERS>\n          Limit output to these change types (Git letter syntax: `ADMR…`)\n\n  -w, --ignore-all-space\n          Ignore whitespace when comparing lines (`git diff -w`)\n\n  -b, --ignore-space-change\n          Ignore changes in the amount of whitespace (`git diff -b`)\n\n      --ignore-blank-lines\n          Ignore changes whose lines are all blank (`git diff --ignore-blank-lines`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "fetch": "Download refs and objects from a remote\n\nUsage: grit fetch [OPTIONS] [REMOTE] [REFSPEC]...\n\nArguments:\n  [REMOTE]\n          Remote to fetch from (defaults to the current branch's remote, else `origin`)\n\n  [REFSPEC]...\n          Refspecs selecting refs to fetch (`main`, `+refs/heads/x:refs/heads/y`, …)\n\nOptions:\n      --all\n          Fetch from every configured remote (respects `remote.<name>.skipFetchAll`)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --tags\n          Fetch all tags from the remote (`git fetch --tags`)\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --no-tags\n          Do not fetch tags automatically (`git fetch --no-tags`)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --prune\n          Remove remote-tracking refs that no longer exist on the remote\n\n      --no-prune\n          Do not prune stale remote-tracking refs, even when config enables it\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --dry-run\n          Report ref updates without writing refs or objects\n\n  -q, --quiet\n          Suppress progress and human output\n\n      --depth <N>\n          Fetch only the recent history of each branch (same as `git fetch --depth`)\n\n      --deepen <N>\n          Deepen an existing shallow clone by this many commits (`git fetch --deepen`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n      --unshallow\n          Convert a shallow repository to a complete one (`git fetch --unshallow`)\n\n  -f, --force\n          Force ref updates that would be rejected (non-fast-forward, tag clobber with `--tags`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "fsck": "Check refs, objects, and pack indexes for problems\n\nUsage: grit fsck [OPTIONS]\n\nOptions:\n      --connectivity-only\n          Check connectivity from refs only (skip store-wide object validation)\n\n      --dangling\n          Report unreachable objects (with `--connectivity-only`, off unless this flag is set)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --no-dangling\n          Do not list dangling objects (matches Git `--no-dangling`)\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --strict\n          Treat ref warnings as errors\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n  -v, --verbose\n          Include info-level object diagnostics in human output (matches Git `--verbose`)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc": "Pack refs, expire reflogs, repack, prune, and refresh commit-graph\n\nUsage: grit gc [OPTIONS] [COMMAND]\n\nCommands:\n  repack            Repack reachable objects into one pack\n  commit-graph      Write a reachable commit-graph with changed-path Bloom filters\n  midx              Write or refresh the multi-pack-index\n  pack-refs         Pack loose refs into `packed-refs` (or compact reftable)\n  prune             Delete unreachable loose objects\n  offload           Move large blobs to a large-object promisor remote and drop them here\n  drop-large-blobs  Drop large blobs a promisor remote can supply again and nothing needed recently\n  help              Print this message or the help of the given subcommand(s)\n\nOptions:\n      --dry-run\n          Show what would run without writing\n\n      --auto\n          Run only when `gc.auto` or `gc.autoPackLimit` is exceeded (what commands run on their own)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n  -q, --quiet\n          Suppress progress summary on stderr\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc commit-graph": "Write a reachable commit-graph with changed-path Bloom filters\n\nUsage: grit gc commit-graph [OPTIONS]\n\nOptions:\n      --dry-run\n          Report commit count without writing the graph file\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc drop-large-blobs": "Drop large blobs a promisor remote can supply again and nothing needed recently\n\nUsage: grit gc drop-large-blobs [OPTIONS]\n\nOptions:\n      --min-size <SIZE>\n          Drop blobs at least this big, such as `1m` (default: `maintenance.drop-large-blobs.minSize`, else the promisor's `blob:limit`, else 1m)\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --older-than <DATE>\n          Keep blobs needed since this date (Git approxidate; `now` keeps none for recency). Default: `maintenance.drop-large-blobs.expire`, else `2.weeks.ago`\n\n      --dry-run\n          List the blobs that would be dropped without changing anything\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit gc help [COMMAND]\n\nCommands:\n  repack            Repack reachable objects into one pack\n  commit-graph      Write a reachable commit-graph with changed-path Bloom filters\n  midx              Write or refresh the multi-pack-index\n  pack-refs         Pack loose refs into `packed-refs` (or compact reftable)\n  prune             Delete unreachable loose objects\n  offload           Move large blobs to a large-object promisor remote and drop them here\n  drop-large-blobs  Drop large blobs a promisor remote can supply again and nothing needed recently\n  help              Print this message or the help of the given subcommand(s)\n",
  "gc help commit-graph": "Write a reachable commit-graph with changed-path Bloom filters\n\nUsage: grit gc help commit-graph\n",
  "gc help drop-large-blobs": "Drop large blobs a promisor remote can supply again and nothing needed recently\n\nUsage: grit gc help drop-large-blobs\n",
  "gc help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit gc help help\n",
  "gc help midx": "Write or refresh the multi-pack-index\n\nUsage: grit gc help midx\n",
  "gc help offload": "Move large blobs to a large-object promisor remote and drop them here\n\nUsage: grit gc help offload\n",
  "gc help pack-refs": "Pack loose refs into `packed-refs` (or compact reftable)\n\nUsage: grit gc help pack-refs\n",
  "gc help prune": "Delete unreachable loose objects\n\nUsage: grit gc help prune\n",
  "gc help repack": "Repack reachable objects into one pack\n\nUsage: grit gc help repack\n",
  "gc midx": "Write or refresh the multi-pack-index\n\nUsage: grit gc midx [OPTIONS]\n\nOptions:\n      --dry-run\n          Report pack coverage without writing the index\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc offload": "Move large blobs to a large-object promisor remote and drop them here\n\nUsage: grit gc offload [OPTIONS] --to <REMOTE>\n\nOptions:\n      --to <REMOTE>\n          Promisor remote that receives the blobs (`remote.<name>.url`)\n\n      --blobs <none|SIZE>\n          Blobs to move: `none` for every blob, or a size such as `1m` (blobs at least that big). Defaults to `remote.<REMOTE>.partialCloneFilter`\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --lop-dir <PATH>\n          The promisor's git directory, when its URL is not a local path\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --configure-lop\n          Also set `uploadpack.allowFilter` and `uploadpack.allowAnySHA1InWant` in the promisor\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --dry-run\n          Report what would move without changing anything\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc pack-refs": "Pack loose refs into `packed-refs` (or compact reftable)\n\nUsage: grit gc pack-refs [OPTIONS]\n\nOptions:\n      --dry-run\n          Report refs that would be packed without writing\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc prune": "Delete unreachable loose objects\n\nUsage: grit gc prune [OPTIONS]\n\nOptions:\n      --older-than <DATE>\n          Only remove objects older than this date (Git approxidate syntax)\n\n      --dry-run\n          Report objects that would be deleted without removing them\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "gc repack": "Repack reachable objects into one pack\n\nUsage: grit gc repack [OPTIONS]\n\nOptions:\n      --bitmaps\n          Write a reachability `.bitmap` sidecar for the new pack\n\n  -f, --force\n          Recompute every delta instead of reusing the ones already in packs\n\n      --json\n          Emit machine-readable JSON instead of human-readable text\n\n      --dry-run\n          Report what would be packed without writing\n\n      --markdown\n          Emit agent-friendly Markdown instead of human-readable text\n\n      --filter <EXPR>\n          jq-like expression applied to JSON output (requires `--json`).\n          \n          Iterator-style filters (for example `.commits[].oid`) always emit a JSON array; singular filters (for example `.branch`) emit one value, including `null` when a field is missing.\n\n      --threads <N>\n          Worker threads for parallel library work (`0` = auto, `1` = serial)\n\n      --no-optional-locks\n          Skip opportunistic index updates that take optional locks (same as `GIT_OPTIONAL_LOCKS=0`)\n\n  -h, --help\n          Print help (see a summary with '-h')\n",
  "help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help [COMMAND]\n\nCommands:\n  init         Create a new, empty repository\n  checkout     Start work on a repository from a snapshot of its main branch (or some of its paths) instead of a clone\n  checkin      Send a snapshot checkout's branches back to the server, grafted onto its real history\n  integrate    Merge a branch into the server's target branch (checking it in first), then refresh this checkout\n  sync         Push and pull every active branch between this clone and your space on the server (GitButler Code)\n  share        Work on a branch together with other users of the server: each has their own head of it\n  slice        Named sets of paths to check out together, kept on the server's target branch\n  clone        Copy a remote repository into a new directory\n  remote       List remotes, or add one\n  log          Show recent commits reachable from HEAD\n  revs         List or count commits matching revision ranges\n  merge-base   Find merge bases or test whether one commit is an ancestor of another\n  reflog       Show, delete, or expire reflog entries\n  blame        Show who last modified each line of a file\n  describe     Nearest reachable tag, exact commit distance, and abbreviated id for a revision\n  diff         Show changes as a diff. No argument: uncommitted changes; with a commit: the change that commit introduced; with two commits (or `A..B`) diff their trees\n  show         Show information about a commit, tag, or branch (defaults to HEAD)\n  status       Show what's changed and where you are (this is the default)\n  shortlog     List the commits on this branch that aren't on the target branch yet\n  add          Stage changes. With no paths, stages everything\n  rm           Remove tracked paths from the working tree and index\n  mv           Rename or move tracked paths\n  clean        Remove untracked files from the working tree\n  repack       Pack reachable objects and remove redundant packs\n  gc           Pack refs, expire reflogs, repack, prune, and refresh commit-graph\n  fsck         Check refs, objects, and pack indexes for problems\n  ignore       Query exclude (gitignore) rules\n  hooks        List hook scripts or run one by name\n  patch-id     Print stable patch-IDs for commits or revision ranges\n  resolve      Resolve revision specs to object ids and types\n  cat          Show blob, tree, commit, or tag contents for a revision spec\n  commit       Stage every change and record a new commit\n  branch       List branches, or create / delete / rename / configure one\n  switch       Switch to another branch, remote branch, or detached commit\n  reset        Move the branch tip and optionally reset the index or worktree\n  merge        Merge another branch, tag or commit into the current branch\n  pick         Cherry-pick commits onto the current branch\n  revert       Undo commits with new inverse commits\n  history      Rewrite commits without a sequencer (plan, then apply refs atomically)\n  stash        Save or restore shelved work\n  restore      Restore working tree and/or index paths\n  fetch        Download refs and objects from a remote\n  pull         Fetch from the remote and integrate it into the current branch\n  rebase       Replay local commits onto a new base (atomic ref update)\n  push         Publish refs to a remote\n  bundle       Create, verify, or list git bundle files\n  notes        List, show, add, or remove Git notes on commits\n  tag          List tags, or create / delete one\n  worktree     List, add, or remove linked worktrees\n  auth         Sign in to GitButler Code (GitHub inside a github.com repository), a `grit serve` host, or store a username and token for any HTTPS host\n  update       Update grit to the latest release (re-runs the install script)\n  skill        Print an agent skill (SKILL.md) that explains how to use grit\n  completions  Generate shell completion scripts for bash, zsh, or fish\n  config       Read, set, or list configuration values\n  manager      Git credential helper backed by the Windows Credential Manager\n  serve        Serve repositories over HTTP, with a web view where people sign in with email and password\n  help         Print this message or the help of the given subcommand(s)\n",
  "help add": "Stage changes. With no paths, stages everything\n\nUsage: grit help add\n",
  "help auth": "Sign in to GitButler Code (GitHub inside a github.com repository), a `grit serve` host, or store a username and token for any HTTPS host\n\nUsage: grit help auth [COMMAND]\n\nCommands:\n  logout  Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n  help    Print this message or the help of the given subcommand(s)\n",
  "help auth help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help auth help [COMMAND]\n\nCommands:\n  logout  Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n  help    Print this message or the help of the given subcommand(s)\n",
  "help auth help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help auth help help\n",
  "help auth help logout": "Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n\nUsage: grit help auth help logout\n",
  "help auth logout": "Forget the stored token (sign out) for GitButler Code (GitHub inside a github.com repository), or for a `grit serve` URL\n\nUsage: grit help auth logout\n",
  "help blame": "Show who last modified each line of a file\n\nUsage: grit help blame\n",
