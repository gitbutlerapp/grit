{
  "$id": "https://grit-scm.com/schemas/resolve/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ResolveEntry": {
      "description": "One resolved spec (`--json` row).",
      "properties": {
        "kind": {
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "ref_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "spec": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "oid",
        "size",
        "spec"
      ],
      "type": "object"
    },
    "WarningRecord": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit resolve`.",
  "properties": {
    "results": {
      "items": {
        "$ref": "#/definitions/ResolveEntry"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/definitions/WarningRecord"
      },
      "type": "array"
    }
  },
  "required": [
    "results"
  ],
  "title": "ResolveOutcome",
  "type": "object"
}
