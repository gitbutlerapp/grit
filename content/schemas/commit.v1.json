{
  "$id": "https://grit-scm.com/schemas/commit/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "CommitScopeJson": {
      "description": "JSON scope label for [`CommitOutcome::scope`].",
      "enum": [
        "auto_stage",
        "staged",
        "paths"
      ],
      "type": "string"
    }
  },
  "description": "Result of `grit commit`.",
  "properties": {
    "amended": {
      "type": "boolean"
    },
    "branch": {
      "type": "string"
    },
    "changes": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "oid": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/definitions/CommitScopeJson"
    },
    "subject": {
      "type": "string"
    }
  },
  "required": [
    "amended",
    "branch",
    "changes",
    "oid",
    "scope",
    "subject"
  ],
  "title": "CommitOutcome",
  "type": "object"
}
