{
  "$id": "https://grit-scm.com/schemas/fetch/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "FetchUpdate": {
      "description": "One updated tracking ref. `old_oid`/`new_oid` are full hex, or `null` for a newly-created (`old_oid`) or deleted (`new_oid`) ref.",
      "properties": {
        "new_oid": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_oid": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Rejection detail, present only when `status == \"rejected\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string"
        },
        "remote_ref": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/FetchUpdateStatus"
        }
      },
      "required": [
        "ref",
        "remote_ref",
        "status"
      ],
      "type": "object"
    },
    "FetchShallowDelta": {
      "description": "Shallow boundaries added or removed by a depth/deepen/unshallow fetch.",
      "properties": {
        "added": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "removed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "added",
        "removed"
      ],
      "type": "object"
    },
    "FetchUpdateStatus": {
      "description": "Per-ref fetch status in JSON.",
      "enum": [
        "new",
        "fast_forward",
        "forced",
        "pruned",
        "rejected",
        "up_to_date"
      ],
      "type": "string"
    }
  },
  "description": "Result of `grit fetch`: the refs that changed.",
  "properties": {
    "dry_run": {
      "description": "True when the fetch was a dry run (no refs or objects written).",
      "type": "boolean"
    },
    "rejected": {
      "description": "True when any ref update was rejected (exit 1 when set).",
      "type": "boolean"
    },
    "remote": {
      "type": "string"
    },
    "shallow": {
      "$ref": "#/definitions/FetchShallowDelta"
    },
    "updated": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "updates": {
      "items": {
        "$ref": "#/definitions/FetchUpdate"
      },
      "type": "array"
    }
  },
  "required": [
    "dry_run",
    "rejected",
    "remote",
    "updated",
    "updates"
  ],
  "title": "FetchOutcome",
  "type": "object"
}
