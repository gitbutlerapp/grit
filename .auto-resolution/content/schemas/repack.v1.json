{
  "$id": "https://grit-scm.com/schemas/repack/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit repack`.",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "loose_before": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "objects_packed": {
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "pack_bytes": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "pack_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "packs_before": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "pruned_loose": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "removed_pack_files": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "dry_run",
    "loose_before",
    "packs_before",
    "pruned_loose",
    "removed_pack_files"
  ],
  "title": "RepackOutcome",
  "type": "object"
}
