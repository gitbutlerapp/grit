{
  "$id": "https://grit-scm.com/schemas/config/v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ConfigEntry": {
      "description": "One entry in a `list` outcome. `value` is `null` for a bare/valueless key.",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "scope"
      ],
      "type": "object"
    },
    "ConfigValueWithOrigin": {
      "description": "One value in a `get_all` outcome.",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit config`, tagged by `action`.",
  "oneOf": [
    {
      "properties": {
        "action": {
          "enum": [
            "get"
          ],
          "type": "string"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "line": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "key"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "get_all"
