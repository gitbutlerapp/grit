{
  "$id": "https://grit-scm.com/schemas/blame/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "BlameCommitJson": {
      "properties": {
        "author": {
          "$ref": "#/definitions/Person"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "summary"
      ],
      "type": "object"
    },
    "BlameHunkJson": {
      "properties": {
        "commit": {
          "type": "string"
        },
        "count": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "final_start": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "ignored": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "line_encoding_lossy": {
          "items": {
            "type": "boolean"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "not_committed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "original_path": {
          "type": "string"
        },
        "original_start": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "unblamable": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "commit",
        "count",
        "final_start",
        "lines",
        "original_path",
        "original_start"
      ],
      "type": "object"
    },
    "BlameLineJson": {
      "properties": {
        "commit": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "encoding_lossy": {
          "type": "boolean"
        },
        "final_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "ignored": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "not_committed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "original_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "original_path": {
          "type": "string"
        },
        "unblamable": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "commit",
        "content",
        "final_line",
        "original_line",
        "original_path"
      ],
      "type": "object"
    },
    "Person": {
      "description": "A parsed identity line (`Name <email> <epoch> <tz>`) for stable `--json` output.",
      "properties": {
        "date": {
          "description": "Author or committer timestamp in RFC 3339.",
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "email",
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit blame`.",
  "properties": {
    "commits": {
      "additionalProperties": {
        "$ref": "#/definitions/BlameCommitJson"
      },
      "type": "object"
    },
    "file": {
      "type": "string"
    },
    "hunks": {
      "items": {
        "$ref": "#/definitions/BlameHunkJson"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "lines": {
      "items": {
        "$ref": "#/definitions/BlameLineJson"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "rev": {
      "type": "string"
    }
  },
  "required": [
    "commits",
    "file",
    "rev"
  ],
  "title": "BlameOutcome",
  "type": "object"
}
