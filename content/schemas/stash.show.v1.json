{
  "$id": "https://grit-scm.com/schemas/stash.show/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ChangeStatus": {
      "description": "Machine-readable diff change status (`--json` / `--markdown` contract).",
      "enum": [
        "added",
        "deleted",
        "modified",
        "type_changed",
        "renamed",
        "copied",
        "unmerged"
      ],
      "type": "string"
    },
    "DiffOutcome": {
      "description": "Result of `grit diff`.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/definitions/FileDiff"
          },
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "DiffStat": {
      "description": "A diffstat: per-file insertion/deletion counts plus totals.",
      "properties": {
        "deletions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/definitions/FileStat"
          },
          "type": "array"
        },
        "files_changed": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deletions",
        "files",
        "files_changed",
        "insertions"
      ],
      "type": "object"
    },
    "FileDiff": {
      "description": "One changed file.",
      "properties": {
        "binary": {
          "type": "boolean"
        },
        "hunks": {
          "items": {
            "$ref": "#/definitions/Hunk"
          },
          "type": "array"
        },
        "new_encoding_lossy": {
          "description": "True when new side bytes were decoded with lossy UTF-8.",
          "type": "boolean"
        },
        "new_mode": {
          "description": "New git mode (octal), when present on this side.",
          "type": [
            "string",
            "null"
          ]
        },
        "old_encoding_lossy": {
          "description": "True when old side bytes were decoded with lossy UTF-8.",
          "type": "boolean"
        },
        "old_mode": {
          "description": "Old git mode (octal), when present on this side.",
          "type": [
            "string",
            "null"
          ]
        },
        "old_path": {
          "description": "Pre-rename path, when different from `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Display path (the new path, or the old path for a deletion).",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ChangeStatus"
        }
      },
      "required": [
        "binary",
        "hunks",
        "path",
        "status"
      ],
      "type": "object"
    },
    "FileStat": {
      "properties": {
        "binary": {
          "type": "boolean"
        },
        "deletions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "old_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ChangeStatus"
        }
      },
      "required": [
        "binary",
        "deletions",
        "insertions",
        "path",
        "status"
      ],
      "type": "object"
    },
    "Hunk": {
      "description": "A contiguous run of changes plus surrounding context.",
      "properties": {
        "context": {
          "description": "The enclosing definition line (function/struct/…), when found.",
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "items": {
            "$ref": "#/definitions/Line"
          },
          "type": "array"
        },
        "new_lines": {
          "description": "Lines on the new side in this hunk (context + additions).",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "new_start": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "old_lines": {
          "description": "Lines on the old side in this hunk (context + removals).",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "old_start": {
          "description": "1-based first old/new line numbers in the hunk.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "lines",
        "new_lines",
        "new_start",
        "old_lines",
        "old_start"
      ],
      "type": "object"
    },
    "Line": {
      "description": "JSON schema shape for [`Line`] (`text` or `segments`, never both).",
      "properties": {
        "kind": {
          "$ref": "#/definitions/LineKind"
        },
        "new": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "no_newline_at_eof": {
          "type": "boolean"
        },
        "old": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "segments": {
          "items": {
            "$ref": "#/definitions/Segment"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "LineKind": {
      "enum": [
        "context",
        "add",
        "del"
      ],
      "type": "string"
    },
    "Segment": {
      "description": "A run of text within a line, flagged if it's part of the word-level change.",
      "properties": {
        "emphasis": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit stash show`.",
  "properties": {
    "index": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "patch": {
      "anyOf": [
        {
          "$ref": "#/definitions/DiffOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "stat": {
      "anyOf": [
        {
          "$ref": "#/definitions/DiffStat"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "index"
  ],
  "title": "StashShowOutcome",
  "type": "object"
}
