        "action",
        "key",
        "removed"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "rename_section"
          ],
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "new_name": {
          "type": "string"
        },
        "old_name": {
          "type": "string"
        },
        "preview": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "new_name",
        "old_name"
      ],
      "type": "object"
    },
    {
      "properties": {
        "action": {
          "enum": [
            "remove_section"
          ],
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "section"
      ],
      "type": "object"
    }
