{
  "$id": "https://grit-scm.com/schemas/gc.commit-graph/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "GcAutoReport": {
      "description": "What `grit gc --auto` decided (JSON uses a `status` discriminator).",
      "oneOf": [
        {
          "description": "Below `gc.auto` and `gc.autoPackLimit` (or `gc.auto=0`); nothing ran.",
          "properties": {
            "status": {
              "enum": [
                "not-needed"
              ],
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "description": "Another maintenance run holds `gc.pid`; nothing ran.",
          "properties": {
            "host": {
              "type": [
                "string",
                "null"
              ]
            },
            "pid": {
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "status": {
              "enum": [
                "already-running"
              ],
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "description": "The `pre-auto-gc` hook exited non-zero; nothing ran.",
          "properties": {
            "exit_code": {
              "format": "int32",
              "type": "integer"
            },
            "status": {
              "enum": [
                "declined-by-hook"
              ],
              "type": "string"
            }
          },
          "required": [
            "exit_code",
            "status"
          ],
          "type": "object"
        },
        {
          "description": "Maintenance ran (or would run, with `--dry-run`).",
          "oneOf": [
            {
              "description": "Estimated loose objects above `gc.auto`.",
              "properties": {
                "estimate": {
                  "format": "uint",
                  "minimum": 0.0,
                  "type": "integer"
                },
                "limit": {
                  "format": "uint",
                  "minimum": 0.0,
                  "type": "integer"
                },
                "trigger": {
                  "enum": [
                    "loose-objects"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "estimate",
                "limit",
                "trigger"
              ],
              "type": "object"
            },
            {
              "description": "Packs without `.keep` above `gc.autoPackLimit`.",
              "properties": {
                "count": {
                  "format": "uint",
                  "minimum": 0.0,
                  "type": "integer"
                },
                "limit": {
                  "format": "uint",
                  "minimum": 0.0,
                  "type": "integer"
                },
                "trigger": {
                  "enum": [
                    "packs"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "count",
                "limit",
                "trigger"
              ],
              "type": "object"
            }
          ],
          "properties": {
            "status": {
              "enum": [
                "ran"
              ],
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "GcTaskReport": {
      "description": "One maintenance task report (JSON uses a `task` discriminator).",
      "oneOf": [
        {
          "properties": {
            "duration_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "refs_packed": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "refs_pruned": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "task": {
              "enum": [
                "pack-refs"
              ],
              "type": "string"
            }
          },
          "required": [
            "duration_ms",
            "path",
            "refs_packed",
            "refs_pruned",
            "task"
          ],
          "type": "object"
        },
        {
          "properties": {
            "duration_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "entries_pruned": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "task": {
              "enum": [
                "reflog-expire"
              ],
              "type": "string"
            }
          },
          "required": [
            "duration_ms",
            "entries_pruned",
            "task"
          ],
          "type": "object"
        },
        {
          "properties": {
            "duration_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "loose_before": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "objects_packed": {
              "format": "uint",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "pack_bytes": {
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "pack_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "packs_before": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "pruned_loose": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "removed_pack_files": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "task": {
              "enum": [
                "repack"
              ],
              "type": "string"
            },
            "unreachable_loose_pruned": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "duration_ms",
            "loose_before",
            "packs_before",
            "pruned_loose",
            "removed_pack_files",
            "task",
            "unreachable_loose_pruned"
          ],
          "type": "object"
        },
        {
          "properties": {
            "duration_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "kept": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "pruned": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "task": {
              "enum": [
                "prune"
              ],
              "type": "string"
            }
          },
          "required": [
            "duration_ms",
            "kept",
            "pruned",
            "task"
          ],
          "type": "object"
        },
        {
          "properties": {
            "commit_count": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "duration_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "removed_chain": {
              "type": "boolean"
            },
            "task": {
              "enum": [
                "commit-graph"
              ],
              "type": "string"
            }
          },
          "required": [
            "commit_count",
            "duration_ms",
            "path",
            "removed_chain",
            "task"
          ],
          "type": "object"
        },
        {
          "properties": {
            "bitmap": {
              "type": "string"
            },
            "duration_ms": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "pack_count": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "task": {
              "enum": [
                "midx"
              ],
              "type": "string"
            }
          },
          "required": [
            "bitmap",
            "duration_ms",
            "pack_count",
            "path",
            "task"
          ],
          "type": "object"
        }
      ]
    }
  },
  "description": "Result of `grit gc` and its task subcommands.",
  "properties": {
    "auto": {
      "anyOf": [
        {
          "$ref": "#/definitions/GcAutoReport"
        },
        {
          "type": "null"
        }
      ],
      "description": "Decision of `grit gc --auto`; absent for a plain `grit gc`."
    },
    "dry_run": {
      "type": "boolean"
    },
    "tasks": {
      "items": {
        "$ref": "#/definitions/GcTaskReport"
      },
      "type": "array"
    }
  },
  "required": [
    "dry_run",
    "tasks"
  ],
  "title": "GcOutcome",
  "type": "object"
}
