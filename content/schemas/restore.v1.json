{
  "$id": "https://grit-scm.com/schemas/restore/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "CLI result (mirrors [`RestoreOutcome`] or [`RestoreHunksOutcome`]).",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "removed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "restored": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "restored_hunks": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "restored_lines": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    }
  },
  "required": [
    "removed",
    "restored"
  ],
  "title": "RestoreCliOutcome",
  "type": "object"
}
