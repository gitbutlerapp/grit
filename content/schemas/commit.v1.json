{
  "$id": "https://grit-scm.com/schemas/commit/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit commit`.",
  "properties": {
    "amended": {
      "type": "boolean"
    },
    "branch": {
      "type": "string"
    },
    "changes": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "oid": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "scope": {
      "description": "How the index was prepared: auto_stage (default), staged, or paths.",
      "enum": ["auto_stage", "staged", "paths"],
      "type": "string"
    }
  },
  "required": [
    "amended",
    "branch",
    "changes",
    "oid",
    "scope",
    "subject"
  ],
  "title": "CommitOutcome",
  "type": "object"
}
