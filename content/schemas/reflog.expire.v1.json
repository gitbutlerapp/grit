{
  "$id": "https://grit-scm.com/schemas/reflog.expire/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit reflog expire`.",
  "properties": {
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "entries_pruned": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "refs": {
      "default": [],
      "items": {
        "properties": {
          "pruned": {
            "format": "uint",
            "minimum": 0.0,
            "type": "integer"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "pruned"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "entries_pruned"
  ],
  "title": "ReflogExpireOutcome",
  "type": "object"
}
