{
  "$id": "https://grit-scm.com/schemas/reflog/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "Person": {
      "description": "A parsed identity line (`Name <email> <epoch> <tz>`) for stable `--json` output.",
      "properties": {
        "date": {
          "description": "Author or committer timestamp in RFC 3339.",
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "email",
        "name"
      ],
      "type": "object"
    },
    "ReflogListEntry": {
      "properties": {
        "action": {
          "description": "Best-effort action prefix from the message (before the first `\": \"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "committer": {
          "anyOf": [
            {
              "$ref": "#/definitions/Person"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "description": "RFC 3339 timestamp with the recorded zone offset.",
          "type": "string"
        },
        "index": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "new_oid": {
          "type": "string"
        },
        "oid": {
          "description": "Hex `new_oid` (unchanged v1 field).",
          "type": "string"
        },
        "old_oid": {
          "type": "string"
        },
        "relative_date": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "index",
        "message",
        "new_oid",
        "oid",
        "old_oid",
        "relative_date"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit reflog` (list/show).",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/definitions/ReflogListEntry"
      },
      "type": "array"
    },
    "ref": {
      "type": "string"
    },
    "truncated": {
      "description": "`true` when the query stopped before the oldest reflog entry (typically due to `-n`).",
      "type": "boolean"
    }
  },
  "required": [
    "entries",
    "ref",
    "truncated"
  ],
  "title": "ReflogListOutcome",
  "type": "object"
}
