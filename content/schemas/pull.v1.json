{
  "$id": "https://grit-scm.com/schemas/pull/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "MergeConflictJson": {
      "description": "One conflicted path in `--json` pull output.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "PullResult": {
      "description": "Integration result of `grit pull`.",
      "enum": [
        "up_to_date",
        "fast_forward",
        "merged",
        "refused_not_ff",
        "conflicts",
        "set_upstream"
      ],
      "type": "string"
    }
  },
  "description": "Outcome of `grit pull`.",
  "properties": {
    "ahead": {
      "description": "Commits on the current branch not on the upstream when `result` is `refused_not_ff`.",
      "type": [
        "integer",
        "null"
      ]
    },
    "behind": {
      "description": "Commits on the upstream not on the current branch when `result` is `refused_not_ff`.",
      "type": [
        "integer",
        "null"
      ]
    },
    "branch": {
      "description": "Remote branch integrated, or the local branch name for `set_upstream`.",
      "type": "string"
    },
    "change_id": {
      "description": "Stored `change-id` on the resulting commit when `oid` is set and a header is present.",
      "type": [
        "string",
        "null"
      ]
    },
    "conflict_details": {
      "description": "Structured conflict metadata when `result` is `conflicts`.",
      "items": {
        "$ref": "#/definitions/MergeConflictJson"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "conflicts": {
      "description": "Conflicted paths when `result` is `conflicts`.",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "oid": {
      "description": "Resulting commit (fast-forward target, merge commit, or adopted upstream).",
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "$ref": "#/definitions/PullResult"
    },
    "upstream": {
      "description": "For `set_upstream`, the remote-tracking branch that was adopted.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "branch",
    "result"
  ],
  "title": "PullOutcome",
  "type": "object"
}
