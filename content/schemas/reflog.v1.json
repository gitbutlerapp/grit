{
  "$id": "https://grit-scm.com/schemas/reflog/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ReflogListEntry": {
      "properties": {
        "action": {
          "description": "Best-effort action prefix from the message (before the first `\": \"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "relative_date": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "message",
        "oid",
        "relative_date"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit reflog` (list/show).",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/definitions/ReflogListEntry"
      },
      "type": "array"
    },
    "ref": {
      "type": "string"
    },
    "truncated": {
      "description": "`true` when the query stopped before the oldest reflog entry (typically due to `-n`).",
      "type": "boolean"
    }
  },
  "required": [
    "entries",
    "ref",
    "truncated"
  ],
  "title": "ReflogListOutcome",
  "type": "object"
}
