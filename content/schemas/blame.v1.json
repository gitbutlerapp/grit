{
  "$id": "https://grit-scm.com/schemas/blame/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "BlameCommitJson": {
      "properties": {
        "author": {
          "type": "string"
        },
        "author_time": {
          "format": "int64",
          "type": "integer"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "author_time",
        "summary"
      ],
      "type": "object"
    },
    "BlameLineJson": {
      "properties": {
        "commit": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "final_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "original_line": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "commit",
        "content",
        "final_line",
        "original_line"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit blame`.",
  "properties": {
    "commits": {
      "additionalProperties": {
        "$ref": "#/definitions/BlameCommitJson"
      },
      "type": "object"
    },
    "file": {
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/definitions/BlameLineJson"
      },
      "type": "array"
    },
    "rev": {
      "type": "string"
    }
  },
  "required": [
    "commits",
    "file",
    "lines",
    "rev"
  ],
  "title": "BlameOutcome",
  "type": "object"
}
