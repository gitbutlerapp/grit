{
  "$id": "https://grit-scm.com/schemas/stash.push/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "description": "Local changes were saved to the stash.",
      "properties": {
        "message": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "all",
            "staged_only",
            "keep_index"
          ],
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "stashed_hunks": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "stashed_lines": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        }
      },
      "required": [
        "message",
        "oid"
      ],
      "type": "object"
    },
    {
      "description": "`--dry-run` preview of what would be stashed.",
      "properties": {
        "mode": {
          "enum": [
            "all",
            "staged_only",
            "keep_index"
          ],
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stashed_hunks": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "stashed_lines": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "untracked": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    {
      "description": "Working tree and index already matched `HEAD`; nothing was saved.",
      "properties": {
        "stashed": {
          "type": "boolean"
        }
      },
      "required": [
        "stashed"
      ],
      "type": "object"
    }
  ],
  "description": "Result of `grit stash push` (or bare `grit stash`).",
  "title": "StashPushOutcome"
}
