  "help remote help refs": "List references on a remote (like `git ls-remote`)\n\nUsage: grit help remote help refs\n",
  "help remote help remove": "Remove a remote and its remote-tracking refs\n\nUsage: grit help remote help remove\n",
  "help remote help rename": "Rename an existing remote\n\nUsage: grit help remote help rename\n",
  "help remote help set-head": "Set or delete `refs/remotes/<name>/HEAD`\n\nUsage: grit help remote help set-head\n",
  "help remote help set-url": "Set the fetch or push URL for an existing remote\n\nUsage: grit help remote help set-url\n",
  "help remote help show": "Summarize a remote (URLs, branches, pull config)\n\nUsage: grit help remote help show\n",
  "help remote prune": "Delete stale remote-tracking refs without fetching\n\nUsage: grit help remote prune\n",
  "help remote refs": "List references on a remote (like `git ls-remote`)\n\nUsage: grit help remote refs\n",
  "help remote remove": "Remove a remote and its remote-tracking refs\n\nUsage: grit help remote remove\n",
  "help remote rename": "Rename an existing remote\n\nUsage: grit help remote rename\n",
  "help remote set-head": "Set or delete `refs/remotes/<name>/HEAD`\n\nUsage: grit help remote set-head\n",
  "help remote set-url": "Set the fetch or push URL for an existing remote\n\nUsage: grit help remote set-url\n",
  "help remote show": "Summarize a remote (URLs, branches, pull config)\n\nUsage: grit help remote show\n",
  "help repack": "Pack reachable objects and remove redundant packs\n\nUsage: grit help repack\n",
  "help reset": "Move the branch tip and optionally reset the index or worktree\n\nUsage: grit help reset\n",
  "help resolve": "Resolve revision specs to object ids and types\n\nUsage: grit help resolve\n",
  "help restore": "Restore working tree and/or index paths\n\nUsage: grit help restore\n",
  "help revert": "Undo commits with new inverse commits\n\nUsage: grit help revert\n",
  "help revs": "List or count commits matching revision ranges\n\nUsage: grit help revs\n",
  "help rm": "Remove tracked paths from the working tree and index\n\nUsage: grit help rm\n",
  "help serve": "Serve repositories over HTTP, with a web view where people sign in with email and password\n\nUsage: grit help serve [COMMAND]\n\nCommands:\n  add-user  Add a user. Prompts for their password, or generates a temporary one\n  token     Create an access token for a user, for scripts and CI that cannot sign in in a browser\n  grant     Give a user read access to a repository (or write access with `--write`)\n  users     List users, their tokens and their repository access\n  help      Print this message or the help of the given subcommand(s)\n",
  "help serve add-user": "Add a user. Prompts for their password, or generates a temporary one\n\nUsage: grit help serve add-user\n",
  "help serve grant": "Give a user read access to a repository (or write access with `--write`)\n\nUsage: grit help serve grant\n",
  "help serve help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help serve help [COMMAND]\n\nCommands:\n  add-user  Add a user. Prompts for their password, or generates a temporary one\n  token     Create an access token for a user, for scripts and CI that cannot sign in in a browser\n  grant     Give a user read access to a repository (or write access with `--write`)\n  users     List users, their tokens and their repository access\n  help      Print this message or the help of the given subcommand(s)\n",
  "help serve help add-user": "Add a user. Prompts for their password, or generates a temporary one\n\nUsage: grit help serve help add-user\n",
  "help serve help grant": "Give a user read access to a repository (or write access with `--write`)\n\nUsage: grit help serve help grant\n",
  "help serve help help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help serve help help\n",
  "help serve help token": "Create an access token for a user, for scripts and CI that cannot sign in in a browser\n\nUsage: grit help serve help token\n",
  "help serve help users": "List users, their tokens and their repository access\n\nUsage: grit help serve help users\n",
  "help serve token": "Create an access token for a user, for scripts and CI that cannot sign in in a browser\n\nUsage: grit help serve token\n",
  "help serve users": "List users, their tokens and their repository access\n\nUsage: grit help serve users\n",
  "help share": "Work on a branch together with other users of the server: each has their own head of it\n\nUsage: grit help share [COMMAND]\n\nCommands:\n  add      Share a branch of your space with people, or make a share link\n  list     List your shared branches, and where each member's head is\n  accept   Accept a share link, and fetch the branch (or clone your copy)\n  remove   Remove people from a shared branch, or end its share when you name nobody\n  leave    Leave a shared branch; your head stays a branch in your space\n  resolve  Put your head and another member's back together after they diverged\n  revoke   Revoke a share link\n  help     Print this message or the help of the given subcommand(s)\n",
  "help share accept": "Accept a share link, and fetch the branch (or clone your copy)\n\nUsage: grit help share accept\n",
  "help share add": "Share a branch of your space with people, or make a share link\n\nUsage: grit help share add\n",
  "help share help": "Print this message or the help of the given subcommand(s)\n\nUsage: grit help share help [COMMAND]\n\nCommands:\n  add      Share a branch of your space with people, or make a share link\n  list     List your shared branches, and where each member's head is\n  accept   Accept a share link, and fetch the branch (or clone your copy)\n  remove   Remove people from a shared branch, or end its share when you name nobody\n  leave    Leave a shared branch; your head stays a branch in your space\n  resolve  Put your head and another member's back together after they diverged\n  revoke   Revoke a share link\n  help     Print this message or the help of the given subcommand(s)\n",
  "help share help accept": "Accept a share link, and fetch the branch (or clone your copy)\n\nUsage: grit help share help accept\n",
  "help share help add": "Share a branch of your space with people, or make a share link\n\nUsage: grit help share help add\n",
