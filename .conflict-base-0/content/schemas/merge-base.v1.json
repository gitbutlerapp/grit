{
  "$id": "https://grit-scm.com/schemas/merge-base/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit merge-base`.",
  "properties": {
    "is_ancestor": {
      "description": "Set when `--is-ancestor` is used.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "merge_bases": {
      "description": "Merge-base object ids (`--all` may return more than one).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "merge_bases"
  ],
  "title": "MergeBaseOutcome",
  "type": "object"
}
