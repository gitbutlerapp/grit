{
  "$id": "https://grit-scm.com/schemas/error/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "description": "Usual command failure (`{\"error\":\"…\"}` only).",
      "properties": {
        "error": {
          "description": "Same text a human sees after `error:` on stderr.",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    {
      "allOf": [
        {
          "$ref": "#/definitions/StructuredJsonError"
        }
      ],
      "description": "Typed failure (conflicts, …)."
    }
  ],
  "definitions": {
    "StructuredJsonError": {
      "description": "JSON object emitted on stdout for structured command failures.",
      "properties": {
        "commit": {
          "description": "Commit that could not be replayed cleanly, when `kind == \"conflict\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "conflicts": {
          "description": "Conflicting paths, when `kind == \"conflict\"`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "error": {
          "description": "Short, stable summary for scripts.",
          "type": "string"
        },
        "kind": {
          "description": "Machine-readable category (e.g. `conflict`).",
          "type": "string"
        },
        "oid": {
          "description": "Plain SHA-1 digest for colliding input, when `kind == \"hash_collision\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "would_overwrite": {
          "anyOf": [
            {
              "$ref": "#/definitions/WouldOverwriteJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "Overwrite details when `kind == \"would_overwrite\"`."
        }
      },
      "required": [
        "error",
        "kind"
      ],
      "type": "object"
    },
    "WouldOverwriteJson": {
      "description": "Paths that would be overwritten, when `kind == \"would_overwrite\"`.",
      "properties": {
        "paths": {
          "description": "Sorted, deduplicated repository-relative paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "`local_changes` or `untracked`.",
          "type": "string"
        }
      },
      "required": [
        "paths",
        "reason"
      ],
      "type": "object"
    }
  },
  "description": "Any `--json` failure object on stdout (schema contract only; see `error.v1.json`).",
  "title": "JsonErrorEnvelope"
}
