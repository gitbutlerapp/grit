{
  "$id": "https://grit-scm.com/schemas/pull/v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "MergeConflictJson": {
      "description": "One conflicted path in `--json` output (pull v1 `conflict_details` and merge v2 items).",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "PullCheckJson": {
      "description": "Dry-run summary from `grit pull --check`.",
      "properties": {
        "ahead": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "behind": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "fast_forward_possible": {
          "type": "boolean"
        },
        "would": {
          "$ref": "#/definitions/PullResult"
        }
      },
      "required": [
        "ahead",
        "behind",
        "fast_forward_possible",
        "would"
      ],
      "type": "object"
    },
    "PullRefreshJson": {
      "description": "What `grit pull` refreshed in a checkout.",
      "properties": {
        "base": {
          "description": "The real commit the newest snapshot stands for. With `--dry-run`, where the target is now.",
          "type": "string"
        },
        "behind": {
          "description": "Other branches with commits of their own still on an older snapshot.",
          "items": {
            "$ref": "#/definitions/RefreshBehindJson"
          },
          "type": "array"
        },
        "changes": {
          "anyOf": [
            {
              "$ref": "#/definitions/RefreshChangesJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "What changed in the checkout's paths between the two snapshots; null when the target didn't move."
        },
        "dry_run": {
          "description": "With `--dry-run`: nothing was fetched or changed, and the server made no snapshot.",
          "type": "boolean"
        },
        "followed": {
          "description": "Local branches with no commits of their own that moved to the new snapshot: the one named after the target, and others whose commits all landed in the target.",
          "items": {
            "$ref": "#/definitions/RefreshFollowedJson"
          },
          "type": "array"
        },
        "moved": {
          "description": "Whether the target had moved since the checkout's last snapshot.",
          "type": "boolean"
        },
        "previous_base": {
          "description": "The real commit the checkout's previous snapshot stood for.",
          "type": [
            "string",
            "null"
          ]
        },
        "previous_snapshot": {
          "description": "The checkout's previous snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": {
          "description": "The newest snapshot commit, now `origin/<target>`. With `--dry-run`, the checkout's snapshot as it is.",
          "type": "string"
        },
        "target": {
          "description": "The server's target branch.",
          "type": "string"
        },
        "upstream_ref": {
          "description": "The local ref holding the newest snapshot, `refs/remotes/origin/<target>`.",
          "type": "string"
        }
      },
      "required": [
        "base",
        "behind",
        "dry_run",
        "followed",
        "moved",
        "snapshot",
        "target",
        "upstream_ref"
      ],
      "type": "object"
    },
    "PullResult": {
      "description": "Result of `grit pull` (`--json` contract).",
      "enum": [
        "up_to_date",
        "fast_forward",
        "merged",
        "refused_not_ff",
        "conflicts",
        "set_upstream",
        "rebased",
        "autostash_conflict",
        "rebase_stopped",
        "detached",
        "landed"
      ],
      "type": "string"
    },
    "RefreshBehindJson": {
      "description": "A branch still building on an older snapshot after a refresh.",
      "properties": {
        "name": {
          "description": "The branch.",
          "type": "string"
        },
        "tip": {
          "description": "Its tip.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "tip"
      ],
      "type": "object"
    },
    "RefreshChangesJson": {
      "description": "What changed in a checkout's paths between two snapshots, as `git diff --shortstat` counts it.",
      "properties": {
        "deletions": {
          "description": "Lines removed.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "files": {
          "description": "Files changed.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "description": "Lines added.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deletions",
        "files",
        "insertions"
      ],
      "type": "object"
    },
    "RefreshFollowedJson": {
      "description": "A branch a refresh moved along with the snapshot.",
      "properties": {
        "from": {
          "description": "The older snapshot it was at.",
          "type": "string"
        },
        "name": {
          "description": "The branch.",
          "type": "string"
        },
        "to": {
          "description": "The new snapshot it is at.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "name",
        "to"
      ],
      "type": "object"
    }
  },
  "description": "Outcome of `grit pull`.",
  "properties": {
    "ahead": {
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "alternatives": {
      "description": "Abort/skip commands (not part of the ordered sequence).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "autostash": {
      "description": "Autostash commit kept on `refs/stash` (rebase stopped, or re-applying it conflicted).",
      "type": [
        "string",
        "null"
      ]
    },
    "behind": {
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "branch": {
      "type": "string"
    },
    "change_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "check": {
      "anyOf": [
        {
          "$ref": "#/definitions/PullCheckJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit": {
      "description": "Local commit the rebase stopped on (`operation` is `rebase`).",
      "type": [
        "string",
        "null"
      ]
    },
    "conflict_details": {
      "items": {
        "$ref": "#/definitions/MergeConflictJson"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "next_steps": {
      "description": "Ordered `grit` commands to finish the paused operation.",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "oid": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "description": "Paused operation when `result` is `conflicts`: `merge` or `rebase`.",
      "type": [
        "string",
        "null"
      ]
    },
    "refresh": {
      "anyOf": [
        {
          "$ref": "#/definitions/PullRefreshJson"
        },
        {
          "type": "null"
        }
      ],
      "description": "In a snapshot checkout, the server snapshot the pull refreshed onto."
    },
    "result": {
      "$ref": "#/definitions/PullResult"
    },
    "upstream": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "branch",
    "result"
  ],
  "title": "PullOutcome",
  "type": "object"
}
