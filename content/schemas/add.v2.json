{
  "$id": "https://grit-scm.com/schemas/add/v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `grit add`: paths staged or that would be staged.",
  "properties": {
    "added": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "count": {
      "description": "Total paths touched (same as `staged`; kept for one release).",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "dry_run": {
      "type": "boolean"
    },
    "embedded_gitlinks": {
      "description": "Nested repositories newly recorded as gitlinks (mode 160000).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "intent_to_add": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "modified": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "removed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "staged": {
      "description": "How many paths were staged (alias of `count` for scripts written before path lists).",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "staged_hunks": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Hunk ids staged per path when `--hunks` was used (empty object when unused).",
      "type": "object"
    },
    "staged_lines": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Line ranges staged per path when `--lines` was used (`start-end` strings; empty when unused).",
      "type": "object"
    }
  },
  "required": [
    "added",
    "count",
    "dry_run",
    "intent_to_add",
    "modified",
    "removed",
    "staged",
    "staged_hunks",
    "staged_lines"
  ],
  "title": "AddOutcome",
  "type": "object"
}
