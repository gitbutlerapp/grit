{
  "$id": "https://grit-scm.com/schemas/fetch.all/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "FetchAllRemoteOutcome": {
      "description": "One remote's result inside [`FetchAllOutcome`].",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "type": "string"
        },
        "updated": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "updates": {
          "items": {
            "$ref": "#/definitions/FetchUpdate"
          },
          "type": "array"
        }
      },
      "required": [
        "remote",
        "updated",
        "updates"
      ],
      "type": "object"
    },
    "FetchUpdate": {
      "description": "One updated tracking ref. `old_oid`/`new_oid` are full hex, or `null` for a newly-created (`old_oid`) or deleted (`new_oid`) ref.",
      "properties": {
        "new_oid": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_oid": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Rejection detail, present only when `status == \"rejected\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string"
        },
        "remote_ref": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/FetchUpdateStatus"
        }
      },
      "required": [
        "ref",
        "remote_ref",
        "status"
      ],
      "type": "object"
    },
    "FetchUpdateStatus": {
      "description": "Per-ref fetch status in JSON.",
      "enum": [
        "new",
        "fast_forward",
        "forced",
        "pruned",
        "rejected",
        "up_to_date"
      ],
      "type": "string"
    }
  },
  "description": "Result of `grit fetch --all`.",
  "properties": {
    "remotes": {
      "items": {
        "$ref": "#/definitions/FetchAllRemoteOutcome"
      },
      "type": "array"
    },
    "updated": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "remotes",
    "updated"
  ],
  "title": "FetchAllOutcome",
  "type": "object"
}
